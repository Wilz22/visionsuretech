---
import "../styles/global.css";

import SEO from "../components/seo/SEO.astro";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import WhatsAppButton from '../components/ui/WhatsAppButton.astro';
import OrganizationSchema from '../components/seo/OrganizationSchema.astro';
import {buildPageShell} from '../lib/page-shell';
import {defaultLocale,type Locale} from '../i18n/config';

interface Props {
  locale?:Locale;
  resolveHref?:(href:string)=>string;
  title: string;
  description: string;
  image?: string;
  canonical?: string;
  noindex?: boolean;
  type?: "website" | "article";
}

const {
  locale=defaultLocale,
  resolveHref,
  title,
  description,
  image,
  canonical,
  noindex = false,
  type = "website",
} = Astro.props;
const shell=buildPageShell(locale,resolveHref);
---

<!doctype html>
<html lang={shell.metadata.htmlLang}>
  <head>
    <meta charset="UTF-8" />

    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <meta name="generator" content={Astro.generator} />

    <SEO
      openGraphLocale={shell.metadata.openGraph}
      title={title}
      description={description}
      image={image}
      canonical={canonical}
      noindex={noindex}
      type={type}
    />

    <link rel="sitemap" href="/sitemap-index.xml" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <meta name="theme-color" content="#F7F7F5" />

    <slot name="head" />
    <OrganizationSchema />
  </head>

  <body>
    <Header locale={locale} copy={shell.messages.navigation} navigation={shell.navigation.main} homeLabel={shell.homeLabel} homeHref={shell.homeHref}/>

    <main>
      <slot />
    </main>
    <Footer locale={locale} navigation={shell.navigation} copy={shell.messages.footer} common={shell.messages.common}/>
    <WhatsAppButton copy={shell.messages.common}/>
  </body>
</html>
