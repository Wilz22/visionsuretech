---
import TablerIcon from "../ui/TablerIcon.astro";
import type {HomeCopy} from '../../i18n/home-types';
interface Props {copy:HomeCopy['dashCams'];compareHref:string;assessmentHref:string;}
const {copy,compareHref,assessmentHref}=Astro.props;
---
<section class="bg-surface-brand py-16"><div class="container grid items-center gap-8 lg:grid-cols-2"><div><p class="text-xs font-extrabold tracking-widest text-brand-600 uppercase">{copy.eyebrow}</p><h2 class="mt-4 text-3xl font-bold tracking-tight text-ink sm:text-4xl">{copy.title}</h2><p class="mt-5 leading-8 text-copy">{copy.description}</p></div><div class="flex flex-wrap gap-4"><a href={compareHref} class="inline-flex min-h-12 items-center gap-2 rounded-pill bg-brand-500 px-6 font-bold text-white">{copy.compare} <TablerIcon name="chevronRight" class="inline-block h-4 w-4 shrink-0 align-middle" /></a><a href={assessmentHref} class="inline-flex min-h-12 items-center rounded-pill border border-line-medium bg-white px-6 font-bold text-brand-600">{copy.assessment}</a></div></div></section>
