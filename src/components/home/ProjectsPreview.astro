---
import TablerIcon from "../ui/TablerIcon.astro";
import type {Project} from '../../lib/projects';
import type {HomeCopy} from '../../i18n/home-types';
import ProjectCard from '../projects/ProjectCard.astro';
import type {Messages} from '../../i18n/types';
interface Props {projectCopy:Messages['projectUi'];projectHref:(project:Project)=>string;projects:Project[];copy:HomeCopy['projects'];projectsHref:string;}
const {projects,copy,projectsHref,projectCopy,projectHref}=Astro.props;
const hasReferences = projects.some(({ entry }) => entry.data.status === 'reference');
---

{projects.length > 0 && <section class="border-t border-line-light bg-page py-20 sm:py-24" aria-labelledby="projects-heading">
  <div class="container">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <div class="max-w-2xl">
        <p class="text-xs font-extrabold tracking-widest text-brand-600 uppercase">{copy.eyebrow}</p>
        <h2 id="projects-heading" class="mt-4 text-4xl font-bold leading-tight tracking-[-0.04em] text-ink sm:text-5xl">{copy.title.map((line,index)=><>{index>0 && <br/>}{line}</>)}</h2>
      </div>
      <a href={projectsHref} class="inline-flex min-h-12 items-center gap-3 rounded-pill border border-line-medium px-6 text-sm font-bold text-brand-600 hover:border-brand-500">{copy.explore} <TablerIcon name="chevronRight" class="inline-block h-4 w-4 shrink-0 align-middle" /></a>
    </div>
    {hasReferences && <p class="mt-6 max-w-2xl text-sm leading-7 text-copy">{copy.notice}</p>}
    <ul class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {projects.map((project) => <li><ProjectCard project={project} copy={projectCopy} href={projectHref(project)} /></li>)}
    </ul>
  </div>
</section>}
