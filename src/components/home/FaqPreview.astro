---
import TablerIcon from "../ui/TablerIcon.astro";
import FaqAccordion from '../faq/FaqAccordion.astro';
import type {FaqEntry} from '../../lib/faq';
import type {HomeCopy} from '../../i18n/home-types';
interface Props {relatedLabel:string;items:FaqEntry[];copy:HomeCopy['faq'];faqHref:string;}
const {items,copy,faqHref,relatedLabel}=Astro.props;
---

<section class="border-t border-line-light bg-surface-soft py-20 sm:py-24" aria-labelledby="home-faq-heading">
  <div class="container grid items-start gap-10 lg:grid-cols-[0.75fr_1.25fr] lg:gap-16">
    <div>
      <p class="text-xs font-extrabold tracking-widest text-brand-600 uppercase">{copy.eyebrow}</p>
      <h2 id="home-faq-heading" class="mt-4 text-4xl leading-tight font-bold tracking-[-0.04em] text-ink sm:text-5xl">{copy.title}</h2>
      <p class="mt-5 max-w-lg leading-8 text-copy">{copy.description}</p>
      <a href={faqHref} class="mt-6 inline-flex min-h-12 items-center gap-3 rounded-pill border border-line-medium bg-white px-6 text-sm font-bold text-brand-600 hover:border-brand-500">{copy.explore} <TablerIcon name="chevronRight" class="inline-block h-4 w-4 shrink-0 align-middle" /></a>
    </div>
    <FaqAccordion items={items} prefix="home-faq" relatedLabel={relatedLabel} />
  </div>
</section>
