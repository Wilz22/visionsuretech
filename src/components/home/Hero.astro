---
import QuoteLink from '../ui/QuoteLink.astro';
import type {HomeCopy} from '../../i18n/home-types';
interface Props { copy:HomeCopy['hero']; quoteHref:string; productsHref:string; imageSrc:string; }
const {copy:hero,quoteHref,productsHref,imageSrc}=Astro.props;
---

<section
  class="relative overflow-hidden bg-page pt-[clamp(72px,9vw,132px)] pb-[clamp(80px,10vw,144px)] max-[600px]:pt-16 max-[600px]:pb-20"
>
  <div
    class="pointer-events-none absolute -top-85 -left-67.5 h-130 w-130 rounded-full bg-brand-500/8"
    aria-hidden="true"
  >
  </div>
  <div
    class="pointer-events-none absolute -right-75 -bottom-100 h-130 w-130 rounded-full bg-brand-500/6"
    aria-hidden="true"
  >
  </div>

  <div class="container">
    <div
      class="relative z-1 grid grid-cols-[minmax(0,0.95fr)_minmax(420px,1.05fr)] items-center gap-[clamp(48px,7vw,104px)] max-[1023px]:grid-cols-1 max-[1023px]:gap-14"
    >
      <div class="max-w-157.5 max-[1023px]:max-w-175">
        <p
          class="mb-3.5 text-[0.8125rem] font-bold tracking-[0.12em] text-brand-600 uppercase"
        >
          {hero.eyebrow}
        </p>

        <h1
          class="m-0 max-w-155 text-[clamp(3rem,5.8vw,5.4rem)] leading-[0.98] font-bold tracking-[-0.055em] text-ink"
        >
          {hero.title.join(" ")}
        </h1>

        <p
          class="mt-7 max-w-143.75 text-[clamp(1.0625rem,1.45vw,1.25rem)] leading-[1.7] text-copy"
        >
          {hero.description}
        </p>

        <div
          class="mt-9 flex flex-wrap items-center gap-5.5 max-[600px]:flex-col max-[600px]:items-stretch max-[600px]:gap-3.75"
        >
          <QuoteLink href={quoteHref} label={hero.primaryCta.label}
            class="group inline-flex min-h-13.5 items-center justify-center gap-2.5 rounded-pill border border-transparent bg-brand-500 px-6.25 py-3 font-bold text-inverse shadow-soft transition-[background-color,color,border-color,transform,box-shadow] duration-250 hover:-translate-y-px hover:bg-brand-600 hover:shadow-raised max-[600px]:w-full motion-reduce:transition-none"
           />

          <a
            href={productsHref}
            class="group inline-flex min-h-11.5 items-center gap-2 text-[0.975rem] font-bold text-brand-600 hover:text-brand-700 max-[600px]:justify-center"
          >
            {hero.secondaryCta.label}
            <span
              class="transition-transform duration-250 group-hover:translate-x-1 motion-reduce:transition-none"
              aria-hidden="true">&rarr;</span
            >
          </a>
        </div>

        <ul
          class="mt-10.5 grid list-none gap-2.5 p-0 text-sm leading-normal text-copy max-[600px]:mt-8.5"
        >
          {hero.points.map(point=><li class="flex items-center gap-2.5 before:h-1.75 before:w-1.75 before:shrink-0 before:rounded-full before:bg-brand-500 before:content-['']">{point}</li>)}
        </ul>
      </div>

      <div class="relative">
        <div
          class="relative min-h-145 overflow-hidden rounded-panel border border-brand-500/12 bg-surface-brand shadow-floating max-[1023px]:min-h-125 max-[600px]:min-h-102.5 max-[600px]:rounded-card"
        >
          <img
            class="absolute inset-0 block h-full w-full object-cover"
            src={imageSrc}
            alt={hero.imageAlt}
            width="1600"
            height="1200"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />

          <div
            class="absolute inset-0 bg-[linear-gradient(180deg,rgba(20,36,48,0.04)_25%,rgba(20,36,48,0.54)_100%)]"
            aria-hidden="true"
          >
          </div>

          <div
            class="absolute top-6 left-6 inline-flex items-center gap-2.25 rounded-pill border border-white/80 bg-white/90 px-3.5 py-2.5 text-xs font-extrabold tracking-[0.04em] text-ink uppercase shadow-soft backdrop-blur-[10px] max-[600px]:top-4 max-[600px]:left-4 max-[600px]:px-2.75 max-[600px]:py-2.25 max-[600px]:text-[0.65rem]"
          >
            <span
              class="h-2 w-2 rounded-full bg-[#3ca66b] shadow-[0_0_0_4px_rgba(60,166,107,0.15)]"
            ></span>
            {hero.reference}
          </div>

          <div
            class="absolute right-6 bottom-6 left-6 rounded-card border border-white/16 bg-[rgba(20,36,48,0.88)] p-5 shadow-raised backdrop-blur-md max-[600px]:right-4 max-[600px]:bottom-4 max-[600px]:left-4 max-[600px]:p-4"
          >
            <p
              class="mb-3.25 text-xs font-extrabold tracking-[0.075em] text-white/90 uppercase"
            >
              {hero.technology}
            </p>

            <div class="flex flex-wrap gap-2">
              {hero.technologies.map(label=><span class="rounded-pill bg-white/12 px-2.5 py-1.75 text-xs font-semibold text-white">{label}</span>)}
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
