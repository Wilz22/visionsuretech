---
import { getCollection } from 'astro:content';
import { homeContent } from '../../data/home';

const solutions = (
  await getCollection(
    'solutions',
    ({ data }) => !data.draft,
  )
).sort(
  (first, second) =>
    first.data.order - second.data.order,
);
---

<section
  class="bg-white py-20 sm:py-24 lg:py-32"
  aria-labelledby="solutions-heading"
>
  <div class="container">
    <div
      class="grid max-w-3xl gap-6 lg:grid-cols-[minmax(0,1fr)_auto] lg:max-w-none lg:items-end lg:gap-12"
    >
      <div>
        <p
          class="mb-4 text-xs font-extrabold uppercase tracking-[0.12em] text-[var(--color-brand-600)]"
        >
          {homeContent.solutions.eyebrow}
        </p>

        <h2
          id="solutions-heading"
          class="max-w-3xl text-4xl font-bold leading-[1.06] tracking-[-0.045em] text-[var(--color-text-primary)] sm:text-5xl lg:text-6xl"
        >
          {homeContent.solutions.title}
        </h2>
      </div>

      <p
        class="max-w-md text-base leading-7 text-[var(--color-text-secondary)] lg:pb-1"
      >
        {homeContent.solutions.description}
      </p>
    </div>

    <ul
      class="mt-12 grid gap-4 sm:grid-cols-2 lg:mt-16 lg:grid-cols-3 lg:gap-5"
    >
      {
        solutions.map((solution) => (
          <li class="h-full">
            <a
              href={`/solutions/${solution.data.slug}`}
              class="group flex h-full min-h-[315px] flex-col rounded-[var(--radius-xl)] border border-[var(--color-border-light)] bg-[var(--color-surface)] p-7 shadow-[var(--shadow-sm)] transition duration-300 hover:-translate-y-1 hover:border-[rgba(47,111,159,0.26)] hover:shadow-[var(--shadow-md)] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[var(--color-brand-500)] sm:p-8"
            >
              <div class="flex items-start justify-between gap-5">
                <span
                  class="text-xs font-extrabold tracking-[0.1em] text-[var(--color-brand-500)]"
                >
                  {String(solution.data.order).padStart(2, '0')}
                </span>

                <span
                  class="flex h-10 w-10 items-center justify-center rounded-full bg-[var(--color-surface-brand)] text-[var(--color-brand-600)] transition duration-300 group-hover:bg-[var(--color-brand-600)] group-hover:text-white"
                  aria-hidden="true"
                >
                  <svg
                    class="h-[18px] w-[18px] transition duration-300 group-hover:translate-x-0.5"
                    viewBox="0 0 24 24"
                  >
                    <path
                      d="M5 12h14M13 6l6 6-6 6"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                </span>
              </div>

              <div class="mt-11">
                <h3
                  class="text-2xl font-bold leading-tight tracking-[-0.03em] text-[var(--color-text-primary)]"
                >
                  {solution.data.title}
                </h3>

                <p
                  class="mt-4 text-[0.9375rem] leading-7 text-[var(--color-text-secondary)]"
                >
                  {solution.data.summary}
                </p>
              </div>

              <div class="mt-auto flex flex-wrap gap-2 pt-8">
                {
                  solution.data.cardTags.map((tag) => (
                    <span
                      class="rounded-full bg-[rgba(47,111,159,0.07)] px-3 py-1.5 text-xs font-bold text-[var(--color-brand-600)]"
                    >
                      {tag}
                    </span>
                  ))
                }
              </div>
            </a>
          </li>
        ))
      }
    </ul>

    <div class="mt-10 flex justify-center sm:mt-12">
      <a
        href={homeContent.solutions.cta.href}
        class="inline-flex min-h-12 items-center gap-2 rounded-[var(--radius-pill)] border border-[var(--color-border-medium)] bg-white px-6 text-sm font-bold text-[var(--color-brand-600)] shadow-[var(--shadow-sm)] transition duration-300 hover:border-[var(--color-brand-500)] hover:text-[var(--color-brand-700)] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[var(--color-brand-500)]"
      >
        {homeContent.solutions.cta.label}

        <svg
          class="h-[18px] w-[18px]"
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <path
            d="M5 12h14M13 6l6 6-6 6"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </svg>
      </a>
    </div>
  </div>
</section>