---
import { homeContent } from '../../data/home';
import { getPublishedSolutions } from '../../lib/solutions';
import { solutionCategories } from '../../data/solutionCategories';
import SystemVisual from '../solutions/SystemVisual.astro';

const solutions = await getPublishedSolutions();
const categories = solutionCategories.filter((category) => solutions.some(({ data }) => data.category === category.id));
---

<section class="bg-surface py-20 sm:py-24 lg:py-32" aria-labelledby="solutions-heading">
  <div class="container">
    <div class="grid max-w-3xl gap-6 lg:max-w-none lg:grid-cols-[minmax(0,1fr)_auto] lg:items-end lg:gap-12">
      <div>
        <p class="mb-4 text-xs font-extrabold tracking-[0.12em] text-brand-600 uppercase">{homeContent.solutions.eyebrow}</p>
        <h2 id="solutions-heading" class="max-w-3xl text-4xl leading-[1.06] font-bold tracking-[-0.045em] text-ink sm:text-5xl lg:text-6xl">{homeContent.solutions.title}</h2>
      </div>
      <p class="max-w-md text-base leading-7 text-copy lg:pb-1">{homeContent.solutions.description}</p>
    </div>

    <ul class="mt-12 grid gap-5 sm:grid-cols-2 lg:mt-16 lg:grid-cols-3">
      {categories.map((category) => {
        const systems = solutions.filter(({ data }) => data.category === category.id);
        return (
          <li class="flex flex-col overflow-hidden rounded-panel border border-line-light bg-surface shadow-soft">
            <div class="relative h-60 border-b border-line-light">
              <SystemVisual solution={systems[0]} />
              <span class="absolute top-4 left-4 rounded-pill px-3 py-1.5 text-xs font-extrabold tracking-widest text-white" style={{ backgroundColor: category.color }}>{category.name}</span>
            </div>
            <div class="flex flex-1 flex-col p-7 sm:p-8">
              <h3 class="text-2xl leading-tight font-bold tracking-[-0.03em] text-ink"><a href={`/solutions#${category.id}`} class="hover:text-brand-600">{category.title}</a></h3>
              <p class="mt-4 text-[0.9375rem] leading-7 text-copy">{category.description}</p>
              <ul class="mt-auto divide-y divide-line-light pt-6">
                {systems.map(({ data }) => <li><a href={`/solutions/${data.slug}`} class="group flex items-center justify-between gap-3 py-3 text-sm font-semibold text-ink hover:text-brand-600"><span><span class="block text-xs font-bold text-brand-600">{data.systemCode}</span><span class="mt-1 block">{data.title}</span></span><span aria-hidden="true" class="text-brand-600">→</span></a></li>)}
              </ul>
            </div>
          </li>
        );
      })}
    </ul>

    <div class="mt-10 flex justify-center sm:mt-12">
      <a href={homeContent.solutions.cta.href} class="inline-flex min-h-12 items-center gap-3 rounded-pill border border-line-medium bg-surface px-6 text-sm font-bold text-brand-600 shadow-soft hover:border-brand-500 hover:text-brand-700">{homeContent.solutions.cta.label}<span aria-hidden="true">→</span></a>
    </div>
  </div>
</section>
