---
import { homeContent } from "../../data/home";

const { whyVisionSure } = homeContent;
---

<section
  class="bg-page py-20 sm:py-24 lg:py-32"
  aria-labelledby="why-visionsure-heading"
>
  <div class="container">
    <div
      class="grid gap-12 lg:grid-cols-[minmax(0,0.86fr)_minmax(0,1.14fr)] lg:gap-20"
    >
      <div class="max-w-xl lg:pt-5">
        <p
          class="mb-4 text-xs font-extrabold uppercase tracking-[0.12em] text-brand-600"
        >
          {whyVisionSure.eyebrow}
        </p>

        <h2
          id="why-visionsure-heading"
          class="text-4xl font-bold leading-[1.06] tracking-[-0.045em] text-ink sm:text-5xl lg:text-6xl"
        >
          {whyVisionSure.title}
        </h2>

        <p
          class="mt-6 max-w-lg text-base leading-7 text-copy sm:text-[1.0625rem]"
        >
          {whyVisionSure.description}
        </p>

        <div
          class="mt-8 flex items-center gap-3 text-sm font-bold text-brand-600"
        >
          <span class="h-px w-14 bg-brand-500" aria-hidden="true"></span>
          Built for demanding operations
        </div>
      </div>

      <ol class="grid gap-4 sm:gap-5">
        {
          whyVisionSure.benefits.map((benefit, index) => (
            <li>
              <article class="group grid gap-5 rounded-panel border border-line-light bg-surface p-6 shadow-soft transition-[transform,border-color,box-shadow] duration-300 hover:-translate-y-1 hover:border-line-brand hover:shadow-raised motion-reduce:transform-none motion-reduce:transition-none sm:grid-cols-[56px_1fr] sm:items-start sm:p-7">
                <span
                  class="flex h-14 w-14 items-center justify-center rounded-control bg-surface-brand text-sm font-extrabold tracking-[0.08em] text-brand-600"
                  aria-hidden="true"
                >
                  {String(index + 1).padStart(2, "0")}
                </span>

                <div class="pt-1">
                  <h3 class="text-xl font-bold leading-tight tracking-[-0.03em] text-ink sm:text-2xl">
                    {benefit.title}
                  </h3>

                  <p class="mt-3 max-w-xl text-[0.9375rem] leading-7 text-copy">
                    {benefit.description}
                  </p>
                </div>
              </article>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>
