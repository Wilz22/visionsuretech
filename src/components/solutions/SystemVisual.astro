---
import type { CollectionEntry } from 'astro:content';

interface Props {
  solution: CollectionEntry<'solutions'>;
  eager?: boolean;
}
const { solution, eager = false } = Astro.props;
const { image, systemCode } = solution.data;
---

<div class="flex h-full min-h-0 items-center justify-center bg-white p-6 sm:p-8">
  {image ? (
    <img
      src={image.src}
      alt={image.alt}
      width={image.width}
      height={image.height}
      loading={eager ? 'eager' : 'lazy'}
      fetchpriority={eager ? 'high' : 'auto'}
      decoding="async"
      class="h-full max-h-full w-full object-contain"
    />
  ) : (
    <div class="w-full max-w-sm text-center">
      <div class="mx-auto flex h-10 w-10 items-center justify-center rounded-control bg-brand-50 text-brand-600" aria-hidden="true">
        <svg viewBox="0 0 48 48" class="h-7 w-7" fill="none" stroke="currentColor" stroke-width="1.5">
          <rect x="7" y="20" width="34" height="21" rx="4" />
          <path d="M14 28h20M14 34h12M18 14a9 9 0 0 1 12 0M13 9a16 16 0 0 1 22 0" stroke-linecap="round" />
        </svg>
      </div>
      <p class="mt-3 text-xs font-bold text-brand-600">{systemCode}</p>
      <p class="mt-2 text-lg leading-tight font-bold tracking-tight text-ink">8 AI channels. One connected fleet.</p>
      <div class="mt-3 flex flex-wrap justify-center gap-2">
        {['WiFi', 'GPS', '4G'].map((label) => <span class="rounded-pill bg-surface-brand px-4 py-1.5 text-xs font-bold text-brand-700">{label}</span>)}
      </div>
    </div>
  )}
</div>
