---
import QuoteLink from './QuoteLink.astro';
import {quoteUrl} from '../../lib/routes';
import CallLink from './CallLink.astro';
import {getMessages} from '../../i18n';
import type {Messages} from '../../i18n/types';
interface Props {slug?:string;copy?:Messages['quoteCta'];label?:string;href?:string}
const {slug,copy=getMessages().quoteCta,label=getMessages().common.quote,href=quoteUrl(slug)}=Astro.props;
---
<section class="rounded-panel bg-surface-brand p-7 sm:p-10"><h2 class="text-2xl font-bold text-ink">{copy.heading}</h2><p class="mt-3 leading-7 text-copy">{copy.description}</p><div class="mt-6 flex flex-wrap items-center gap-6"><QuoteLink href={href} label={label} class="inline-flex min-h-12 items-center rounded-pill bg-brand-500 px-6 font-bold text-white hover:bg-brand-600" /><CallLink/></div></section>
