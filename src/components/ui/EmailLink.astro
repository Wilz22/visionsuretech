---
import TablerIcon from './TablerIcon.astro';
interface Props {email:string|null;class?:string;}
const {email,class:className='flex min-h-11 py-3 text-sm font-bold text-brand-600 hover:text-brand-700'}=Astro.props;
---
{email&&<a href={`mailto:${email}`} class:list={[className,'min-w-0 items-center gap-2']}><TablerIcon name="mail" class="h-5 w-5 shrink-0"/><span class="min-w-0 break-words [overflow-wrap:anywhere]">{email}</span></a>}
