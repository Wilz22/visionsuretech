---
import type { FaqEntry } from '../../lib/faq';
import {getMessages} from '../../i18n';
interface Props {relatedLabel?:string; items: FaqEntry[]; prefix: string; }
const { items, prefix,relatedLabel=getMessages().faqPage.relatedSystems } = Astro.props;
---

<div class="divide-y divide-line-light overflow-hidden rounded-panel border border-line-light bg-white">
  {items.map((item) => (
    <details id={`${prefix}-${item.id}`} class="group scroll-mt-28 open:bg-brand-50/60">
      <summary class="flex min-h-16 cursor-pointer list-none items-center justify-between gap-5 px-6 py-6 text-left text-base leading-7 font-bold text-ink hover:text-brand-600 sm:px-8 [&::-webkit-details-marker]:hidden">
        <span>{item.question}</span>
        <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-surface-brand text-brand-600" aria-hidden="true">
          <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14" /><path d="M12 5v14" class="group-open:hidden" /></svg>
        </span>
      </summary>
      <div class="px-6 pb-7 sm:px-8">
        <p class="max-w-3xl text-sm leading-7 text-copy">{item.answer}</p>
        {item.links.length > 0 && <ul class="mt-5 flex flex-wrap gap-2" aria-label={relatedLabel}>
          {item.links.map((link) => <li><a href={link.href} class="inline-flex min-h-11 items-center rounded-control border border-line-brand bg-white px-3 py-2 text-xs leading-5 font-bold text-brand-600 hover:border-brand-500">{link.label}</a></li>)}
        </ul>}
      </div>
    </details>
  ))}
</div>
