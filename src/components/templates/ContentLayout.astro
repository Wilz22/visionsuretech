---
import ListingLayout from './ListingLayout.astro';
import {getMessages} from '../../i18n';
import type {ContentLayoutCopy} from '../../i18n/page-types';
import {defaultLocale,type Locale} from "../../i18n/config";
interface Props {locale?:Locale;resolveHref?:(href:string)=>string;copy?:ContentLayoutCopy;crumbs?:{label:string;href?:string}[];breadcrumbLabel?:string;title:string;description:string;reference?:boolean}
const locale=Astro.props.locale??defaultLocale;
const {title,description,reference=false,copy=getMessages(locale).contentLayout,crumbs,breadcrumbLabel}=Astro.props;
---
<ListingLayout locale={locale} resolveHref={Astro.props.resolveHref} title={title} description={description} noindex={reference} crumbs={crumbs} breadcrumbLabel={breadcrumbLabel}>{reference&&<aside class="rounded-card border border-line-brand bg-surface-brand p-6 text-sm leading-7 text-copy"><p class="font-bold text-brand-700">{copy.referenceTitle}</p><p>{copy.referenceDescription}</p></aside>}<div class="space-y-10"><slot/></div></ListingLayout>
