---
import ListingLayout from './ListingLayout.astro';
import type {Company} from '../../data/company';
import {company} from '../../data/company';
import CallLink from '../ui/CallLink.astro';
import EmailLink from '../ui/EmailLink.astro';
import {getMessages} from '../../i18n';
import type {Messages} from '../../i18n/types';
import {defaultLocale,type Locale} from "../../i18n/config";
interface Props {locale?:Locale;resolveHref?:(href:string)=>string;contact?:Pick<Company['contact'],'email'|'phone'|'phoneE164'>;crumbs?:{label:string;href?:string}[];breadcrumbLabel?:string;title:string;description:string;reference?:boolean;copy?:Messages['formLayout']}
const locale=Astro.props.locale??defaultLocale;
const {title,description,reference=false,copy=getMessages(locale).formLayout,contact=company.contact,crumbs,breadcrumbLabel}=Astro.props;
---
<ListingLayout locale={locale} resolveHref={Astro.props.resolveHref} title={title} description={description} noindex={reference} crumbs={crumbs} breadcrumbLabel={breadcrumbLabel}><div class="grid items-start gap-10 lg:grid-cols-[1.3fr_0.7fr]"><div class="min-w-0"><slot/></div><aside class="space-y-6"><section class="rounded-panel border border-line-light bg-surface-brand p-7"><h2 class="text-2xl font-bold text-ink">{copy.contactHeading}</h2><CallLink phone={contact.phone} phoneE164={contact.phoneE164}/><EmailLink email={contact.email}/><p class="mt-3 text-sm leading-7 text-copy">{copy.locality}</p><p class="mt-3 text-sm leading-7 text-copy">{copy.addressNotice}</p></section><section class="rounded-panel border border-dashed border-line-brand bg-white p-7"><h2 class="text-xl font-bold text-ink">{copy.locationHeading}</h2><p class="mt-4 text-sm leading-7 text-copy">{copy.mapNotice}</p></section></aside></div></ListingLayout>
