---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { company } from '../../data/company';
import { getMessages } from '../../i18n';
import Breadcrumbs from '../ui/Breadcrumbs.astro';
import { defaultLocale, type Locale } from '../../i18n/config';
interface Props {
  locale?: Locale;
  resolveHref?: (href: string) => string;
  breadcrumbLabel?: string;
  homeLabel?: string;
  brandLabel?: string;
  title: string;
  description: string;
  noindex?: boolean;
  crumbs?: { label: string; href?: string }[];
}
const locale = Astro.props.locale ?? defaultLocale;
const {
  title,
  description,
  noindex = false,
  breadcrumbLabel,
  homeLabel = getMessages(locale).navigation.labels.home,
  brandLabel = company.name,
  crumbs = [
    { label: homeLabel, href: Astro.props.resolveHref?.('/') ?? '/' },
    { label: title },
  ],
} = Astro.props;
---

<BaseLayout
  locale={locale}
  resolveHref={Astro.props.resolveHref}
  title={title}
  description={description}
  noindex={noindex}
  image="/images/solutions/vst-s6301.jpg"
>
  <section class="border-b border-line-light bg-page pt-10 pb-14">
    <div class="container">
      <Breadcrumbs items={crumbs} label={breadcrumbLabel} />
      <p class="text-xs font-extrabold tracking-widest text-brand-600 uppercase">
        {brandLabel}
      </p>
      <h1 class="mt-5 max-w-4xl text-4xl font-bold leading-tight tracking-tight text-ink sm:text-6xl">
        {title}
      </h1>
      <p class="mt-6 max-w-3xl text-lg leading-8 text-copy">{description}</p>
    </div>
  </section>
  <div class="container space-y-12 py-14 sm:py-20">
    <slot />
  </div>
</BaseLayout>
