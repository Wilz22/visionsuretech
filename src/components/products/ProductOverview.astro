---
import type { CollectionEntry } from 'astro:content';
import ProductGrid from './ProductGrid.astro';
import QuoteCta from '../ui/QuoteCta.astro';
import type { CategoryLink } from '../../lib/listing-models';
import type { Messages } from '../../i18n/types';
interface Props {
  products: CollectionEntry<'products'>[];
  categories: CategoryLink[];
  messages: Messages;
  quoteHref: string;
  productHref: (product: CollectionEntry<'products'>) => string;
  locale: string;
}
const { products, categories, messages, quoteHref, productHref, locale } =
  Astro.props;
const copy = messages.productOverview;
---

<nav
  aria-label={copy.navigationLabel}
  class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3"
>
  {categories.map((category) => (
    <a
      href={category.href}
      class="rounded-panel border border-line-light bg-white p-6 hover:border-brand-500"
    >
      <>
        <h2 class="text-xl font-bold text-ink">{category.name}</h2>
        <p class="mt-3 text-sm leading-7 text-copy">{category.description}</p>
      </>
    </a>
  ))}
</nav>
<section>
  <h2 class="mb-6 text-3xl font-bold text-ink">{copy.heading}</h2>
  <ProductGrid
    products={products}
    copy={messages.catalogGrid}
    cardCopy={messages.productCard}
    visualCopy={messages.productVisual}
    productHref={productHref}
    locale={locale}
  />
</section>
<QuoteCta
  copy={messages.quoteCta}
  label={messages.common.quote}
  href={quoteHref}
/>
