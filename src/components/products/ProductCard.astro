---
import TablerIcon from '../ui/TablerIcon.astro';
import type { CollectionEntry } from 'astro:content';
import SystemVisual from '../solutions/SystemVisual.astro';
import CatalogBadge from '../ui/CatalogBadge.astro';
import { productUrl } from '../../lib/routes';
import { getMessages, formatMessage } from '../../i18n';
import type { Messages } from '../../i18n/types';
interface Props {
  product: CollectionEntry<'products'>;
  copy?: Messages['productCard'];
  visualCopy?: Messages['productVisual'];
  href?: string;
}
const {
  product,
  copy = getMessages().productCard,
  visualCopy = getMessages().productVisual,
  href = productUrl(product.data),
} = Astro.props;
const { data } = product;
const keySpecifications = data.specifications.slice(0, 3);
---

<article
  class="flex h-full flex-col overflow-hidden rounded-panel border border-line-light bg-white shadow-soft"
  data-product-card
  data-class={data.catalogClass}
  data-search={`${data.title} ${data.systemCode} ${data.cardTags.join(' ')}`.toLowerCase()}
>
  <div class="relative border-b border-line-light">
    <div class="h-60">
      <SystemVisual solution={product} copy={visualCopy} />
    </div>
    <div class="absolute top-4 left-4">
      <CatalogBadge value={data.catalogClass} />
    </div>
  </div>
  <div class="flex flex-1 flex-col p-6">
    <p class="text-xs font-bold tracking-widest text-brand-600">
      {data.systemCode}
    </p>
    <h3 class="mt-3 text-xl font-bold text-ink">
      <a href={href}>{data.title}</a>
    </h3>
    <p class="mt-4 text-sm leading-7 text-copy">{data.summary}</p>
    <ul class="mt-4 flex flex-wrap gap-2">
      {data.cardTags.map((tag) => (
        <li class="rounded-pill bg-brand-50 px-3 py-1.5 text-xs font-semibold text-brand-700">
          {tag}
        </li>
      ))}
    </ul>
    <dl
      data-key-specifications
      class="mt-5 space-y-3 border-t border-line-light pt-4 text-xs leading-6"
    >
      {keySpecifications.map((spec) => (
        <div class="grid grid-cols-[minmax(0,1fr)_minmax(0,1.3fr)] gap-3">
          <>
            <dt class="font-semibold text-ink">{spec.label}</dt>
            <dd class="min-w-0 wrap-break-word text-copy">{spec.value}</dd>
          </>
        </div>
      ))}
    </dl>
    <a
      href={href}
      class="mt-auto inline-flex min-h-12 items-center pt-5 text-sm font-bold text-brand-600 gap-2"
      aria-label={formatMessage(copy.viewDetailsFor, {
        model: data.systemCode,
      })}
    >
      {copy.viewDetails}
      <TablerIcon
        name="chevronRight"
        class="inline-block h-4 w-4 shrink-0 align-middle ml-3"
      />
    </a>
  </div>
</article>
