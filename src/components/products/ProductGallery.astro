---
import { getMessages, formatMessage } from '../../i18n';
import type { GalleryCopy } from '../../i18n/catalog-types';
interface Image {
  src: string;
  alt: string;
  width: number;
  height: number;
}
interface Props {
  images: Image[];
  title: string;
  copy?: GalleryCopy;
}
const { images, title, copy = getMessages().gallery } = Astro.props;
---

<figure class="overflow-hidden rounded-panel border border-line-light bg-white">
  {images.length ? (
    <>
      <img
        data-gallery-main
        src={images[0].src}
        alt={images[0].alt}
        width={images[0].width}
        height={images[0].height}
        class="h-80 w-full object-contain p-6 sm:h-96"
        loading="eager"
      />
      {images.length > 1 && (
        <div
          class="flex flex-wrap gap-3 border-t border-line-light p-4"
          data-gallery
        >
          {images.map((img, index) => (
            <button
              type="button"
              aria-label={formatMessage(copy.photoLabel, {
                title,
                index: String(index + 1),
              })}
              aria-pressed={index === 0 ? 'true' : 'false'}
              data-src={img.src}
              data-alt={img.alt}
              data-width={img.width}
              data-height={img.height}
              class="rounded-control border border-line-medium p-2 hover:border-brand-500"
            >
              <img
                src={img.src}
                alt=""
                width="64"
                height="64"
                class="h-16 w-16 object-contain"
                loading="lazy"
              />
            </button>
          ))}
        </div>
      )}
    </>
  ) : (
    <div class="flex min-h-80 flex-col items-center justify-center bg-surface-brand p-8 text-center">
      <>
        <span aria-hidden="true" class="text-5xl text-brand-500">
          ◎
        </span>
        <p class="mt-5 font-bold text-ink">{title}</p>
        <p class="mt-3 text-sm text-copy">{copy.pending}</p>
      </>
    </div>
  )}
  <figcaption class="border-t border-line-light px-6 py-4 text-xs leading-6 text-copy">
    {copy.caption}
  </figcaption>
</figure>
<script>
  import '../../scripts/product-gallery';
</script>
