---
import ProductDetail from '../templates/ProductDetail.astro';

import CatalogBadge from '../ui/CatalogBadge.astro';
import ProductGallery from '../products/ProductGallery.astro';
import ProductCard from '../products/ProductCard.astro';
import QuoteCta from '../ui/QuoteCta.astro';
import ProductContactActions from '../ui/ProductContactActions.astro';
import type { IndustrialDetailModel } from '../../lib/detail-models';
import type { Messages } from '../../i18n/types';
import { formatMessage } from '../../i18n/format';
import InlineMessage from '../ui/InlineMessage.astro';
import { defaultLocale, type Locale } from '../../i18n/config';
interface Props {
  locale?: Locale;
  resolveHref?: (href: string) => string;
  model: IndustrialDetailModel;
  messages: Messages;
  whatsappHref: string;
  schema: Record<string, unknown>;
}
const { model, messages, whatsappHref, schema } = Astro.props;
const {
  product,
  industries,
  images,
  related,
  optional,
  crumbs,
  quoteHref,
  glossaryLinks,
} = model;
const { data } = product;
const copy = messages.industrialDetail;
---

<ProductDetail
  locale={Astro.props.locale ?? defaultLocale}
  resolveHref={Astro.props.resolveHref}
  breadcrumbLabel={messages.common.breadcrumb}
  title={data.seo.title}
  heading={data.title}
  description={data.seo.description}
  noindex={data.contentStatus === 'reference'}
  image={data.image?.src}
  crumbs={crumbs}
>
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(schema).replace(/</g, '\\u003c')}
  />
  <section class="container pt-10 pb-14">
    <div class="grid items-start gap-10 lg:grid-cols-2">
      <div>
        <CatalogBadge value={data.catalogClass} />
        <p class="mt-6 text-sm font-bold tracking-wide text-brand-600">
          {data.systemCode}
        </p>
        <p class="mt-6 text-lg leading-8 text-copy">{data.summary}</p>
        <ProductContactActions
          quoteHref={quoteHref}
          whatsappHref={whatsappHref}
          product={`${data.systemCode} — ${data.title}`}
          copy={messages.common}
        />
        <h2 class="mt-8 text-sm font-bold text-ink">{copy.idealFor}</h2>
        <div class="mt-3 flex flex-wrap gap-2">
          {industries.map((industry) => (
            <a
              href={industry.href}
              class="inline-flex min-h-11 items-center rounded-pill border border-line-brand bg-white px-4 text-sm text-brand-700"
            >
              {industry.title}
            </a>
          ))}
        </div>
        <ul class="mt-4 list-disc space-y-2 pl-5 text-sm leading-7 text-copy">
          {data.applications.map((application) => (
            <li>{application}</li>
          ))}
        </ul>
        <p class="mt-5 text-xs leading-6 text-copy">{copy.reference}</p>
      </div>
      <ProductGallery
        images={images}
        title={data.systemCode}
        copy={messages.gallery}
      />
    </div>
  </section>
  <div class="container space-y-14 pb-16">
    <section class="grid gap-8 lg:grid-cols-2">
      <div>
        <h2 class="text-3xl font-bold text-ink">{copy.overview}</h2>
        <div class="mt-5 space-y-4 leading-8 text-copy">
          <slot />
        </div>
      </div>
      <ul class="grid gap-4 sm:grid-cols-2">
        {data.features.map((feature) => (
          <li class="rounded-card border border-line-light bg-white p-6 text-sm leading-7 text-copy">
            {feature}
          </li>
        ))}
      </ul>
    </section>
    <section id="specifications" class="scroll-mt-28">
      <h2 class="text-3xl font-bold text-ink">{copy.specifications}</h2>
      <div class="mt-6 overflow-x-auto rounded-card border border-line-light">
        <table class="w-full text-left text-sm text-copy">
          <caption class="sr-only">
            {formatMessage(copy.specificationsCaption, {
              model: data.systemCode,
            })}
          </caption>
          <thead class="bg-surface-soft text-ink">
            <tr>
              <th scope="col" class="p-5">
                {copy.specification}
              </th>
              <th scope="col" class="p-5">
                {copy.value}
              </th>
            </tr>
          </thead>
          <tbody>
            {data.specifications.map((spec) => (
              <tr class="border-t border-line-light bg-white">
                <>
                  <th scope="row" class="p-5 align-top font-semibold">
                    {spec.label}
                  </th>
                  <td class="p-5 leading-7">{spec.value}</td>
                </>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      {data.notes.map((note) => (
        <p class="mt-3 text-sm leading-7 text-copy">{note}</p>
      ))}
      {data.specSheet ? (
        <a
          href={data.specSheet.href}
          download
          class="mt-5 inline-flex min-h-11 items-center font-bold text-brand-600"
        >
          {data.specSheet.label ?? copy.download}
        </a>
      ) : (
        <p class="mt-5 text-sm text-muted">{copy.pendingPdf}</p>
      )}
    </section>
    <section>
      <h2 class="text-3xl font-bold text-ink">{copy.components}</h2>
      <div class="mt-6 overflow-x-auto rounded-card border border-line-light">
        <table class="w-full text-left text-sm text-copy">
          <caption class="sr-only">
            {formatMessage(copy.componentsCaption, { model: data.systemCode })}
          </caption>
          <thead class="bg-surface-soft text-ink">
            <tr>
              <th scope="col" class="p-4">
                {copy.code}
              </th>
              <th scope="col" class="p-4">
                {copy.component}
              </th>
              <th scope="col" class="p-4">
                {copy.status}
              </th>
            </tr>
          </thead>
          <tbody>
            {data.components.map((item) => (
              <tr class="border-t border-line-light bg-white">
                <>
                  <th
                    scope="row"
                    class="p-4 align-top wrap-break-word font-bold text-brand-600"
                  >
                    {item.code}
                  </th>
                  <td class="p-4 leading-7">{item.description}</td>
                  <td class="p-4 align-top">
                    {copy.availability[item.availability]}
                  </td>
                </>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
    <section class="rounded-panel border border-line-light bg-white p-7">
      <h2 class="text-xl font-bold text-ink">{copy.technology}</h2>
      <p class="mt-3 text-sm leading-7 text-copy">
        <InlineMessage message={copy.glossaryMessage} links={glossaryLinks} />
      </p>
    </section>
    {optional.length > 0 && (
      <section>
        <>
          <h2 class="text-2xl font-bold text-ink">{copy.optional}</h2>
          <ul class="mt-5 grid gap-4 sm:grid-cols-2">
            {optional.map((item) => (
              <li class="rounded-card border border-line-light bg-white p-6">
                <h3 class="font-bold text-brand-600">{item.code}</h3>
                <p class="mt-3 text-sm leading-7 text-copy">
                  {item.description}
                </p>
              </li>
            ))}
          </ul>
        </>
      </section>
    )}
    {related.length > 0 && (
      <section>
        <>
          <h2 class="text-3xl font-bold text-ink">{copy.related}</h2>
          <div class="mt-7 grid gap-6 md:grid-cols-2 xl:grid-cols-3">
            {related.map((item) => (
              <ProductCard
                product={item.product}
                href={item.href}
                copy={messages.productCard}
                visualCopy={messages.productVisual}
              />
            ))}
          </div>
        </>
      </section>
    )}
    <QuoteCta
      copy={messages.quoteCta}
      label={messages.common.quote}
      href={quoteHref}
    />
  </div>
</ProductDetail>
