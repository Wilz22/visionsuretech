---
import { testimonials } from '../../data/testimonials';
import type { Messages } from '../../i18n/types';
import { formatMessage } from '../../i18n/format';
interface Props {
  industryId: string;
  copy: Messages['testimonialUi'];
}
const { industryId, copy } = Astro.props;
const entry = testimonials.find((item) => item.industryId === industryId);
const text = entry ? copy.byId[entry.id] : null;
---

{entry && text && (
  <section aria-labelledby="testimonial-heading">
    <h2 id="testimonial-heading" class="text-3xl font-bold text-ink">
      {copy.heading}
    </h2>
    <figure class="mx-auto mt-6 max-w-4xl overflow-hidden rounded-panel border border-line-light bg-white">
      <video
        controls
        playsinline
        preload="none"
        poster={entry.poster}
        aria-label={formatMessage(copy.videoLabel, { name: text.title })}
        class="block aspect-video w-full bg-black object-contain"
        data-testimonial-video
      >
        <source src={entry.videoUrl} type="video/mp4" />
        <p>{copy.fallback}</p>
      </video>
      <figcaption class="p-6 sm:p-7">
        <h3 class="text-xl font-bold text-ink">{text.title}</h3>
        <p class="mt-2 leading-7 text-copy">{text.description}</p>
      </figcaption>
    </figure>
  </section>
)}
