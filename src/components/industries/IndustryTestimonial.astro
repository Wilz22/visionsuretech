---
import {testimonials} from '../../data/testimonials';
import type {Messages} from '../../i18n/types';
import TablerIcon from '../ui/TablerIcon.astro';
interface Props {industryId:string;copy:Messages['testimonialUi'];}
const {industryId,copy}=Astro.props;
const entry=testimonials.find(item=>item.industryId===industryId);
const text=entry ? copy.byId[entry.id] : null;
---
{entry&&text&&<section aria-labelledby="testimonial-heading">
  <h2 id="testimonial-heading" class="text-3xl font-bold text-ink">{copy.heading}</h2>
  <div class="mt-6 flex flex-col items-start gap-6 rounded-panel border border-line-light bg-white p-7 sm:flex-row sm:items-center">
    <div class="flex h-16 w-16 shrink-0 items-center justify-center rounded-2xl bg-surface-brand text-brand-600"><TablerIcon name="youtube" class="h-8 w-8"/></div>
    <div class="flex-1"><h3 class="text-xl font-bold text-ink">{text.title}</h3><p class="mt-2 leading-7 text-copy">{text.description}</p></div>
    {entry.videoUrl ? <a href={entry.videoUrl} target="_blank" rel="noopener noreferrer" class="inline-flex min-h-11 items-center gap-2 rounded-pill bg-brand-500 px-5 py-3 text-sm font-bold text-white hover:bg-brand-600">{copy.watch}<TablerIcon name="chevronRight" class="h-4 w-4"/></a> : <span class="rounded-pill bg-surface-soft px-4 py-3 text-sm text-copy">{copy.comingSoon}</span>}
  </div>
</section>}
