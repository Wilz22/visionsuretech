---
import type {AboutCopy} from '../../i18n/page-types';
import QuoteLink from '../ui/QuoteLink.astro';
import CallLink from '../ui/CallLink.astro';
import type {HomeCategory} from '../../i18n/home-types';
interface Props {copy:AboutCopy;paragraphs:readonly string[];categories:HomeCategory[];planningHref:string;email:string|null;quoteHref:string;quoteLabel:string;}
const {copy,paragraphs,categories,planningHref,email,quoteHref,quoteLabel}=Astro.props;
---
<section><h2 class="text-3xl font-bold text-ink">{copy.introTitle}</h2>{paragraphs.map(text=><p class="mt-5 max-w-3xl leading-8 text-copy">{text}</p>)}<p class="mt-5 max-w-3xl leading-8 text-copy">{copy.historyPending}</p></section><section><h2 class="text-2xl font-bold text-ink">{copy.location.title}</h2><p class="mt-4 leading-8 text-copy">{copy.location.text}</p></section><section><h2 class="text-2xl font-bold text-ink">{copy.brands.title}</h2><p class="mt-4 leading-8 text-copy">{copy.brands.text}</p><ul class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">{categories.map(category=><li><a href={category.href} class="flex min-h-24 items-center rounded-card border border-line-light p-5 font-bold text-brand-600">{category.name} <span aria-hidden="true">→</span></a></li>)}</ul></section><section><h2 class="text-2xl font-bold text-ink">{copy.planning.title}</h2><ol class="mt-6 grid gap-4 md:grid-cols-3">{copy.planning.steps.map((text,index)=><li class="rounded-card border border-line-light p-6"><p class="font-bold text-brand-600">0{index+1}</p><p class="mt-3 leading-7 text-copy">{text}</p></li>)}</ol><a href={planningHref} class="mt-5 inline-flex min-h-11 items-center font-bold text-brand-600">{copy.planning.label} <span aria-hidden="true">→</span></a></section><section><h2 class="text-2xl font-bold text-ink">{copy.contactTitle}</h2><div class="mt-5 flex flex-wrap items-center gap-6"><CallLink/><a href={`mailto:${email}`} class="inline-flex min-h-11 items-center font-bold text-brand-600 break-all">{email}</a><QuoteLink href={quoteHref} label={quoteLabel} class="inline-flex min-h-12 items-center rounded-pill bg-brand-500 px-6 font-bold text-white" /></div></section>