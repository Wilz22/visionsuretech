---
import TablerIcon from "../ui/TablerIcon.astro";
import type {NotFoundCopy} from '../../i18n/page-types';
interface Props {copy:NotFoundCopy;homeHref:string;productsHref:string;links:{href:string;title:string;text:string}[];}
const {copy,homeHref,productsHref,links}=Astro.props;
---
  <section class="container py-20 sm:py-28">
    <div class="mx-auto max-w-3xl text-center">
      <p class="text-sm font-extrabold tracking-[0.2em] text-brand-600">{copy.eyebrow}</p>
      <h1 class="mt-6 text-4xl font-bold leading-[1.08] tracking-[-0.045em] text-ink sm:text-6xl">{copy.heading.map((line,index)=><>{index>0&&<br/>}{line}</>)}</h1>
      <p class="mx-auto mt-6 max-w-xl text-lg leading-8 text-copy">{copy.text}</p>
      <div class="mt-9 flex flex-wrap justify-center gap-3"><a href={homeHref} class="inline-flex min-h-12 items-center rounded-pill bg-brand-500 px-6 py-3 text-sm font-bold text-white hover:bg-brand-600">{copy.home}</a><a href={productsHref} class="inline-flex min-h-12 items-center rounded-pill border border-line-medium bg-white px-6 py-3 text-sm font-bold text-brand-600 hover:border-brand-500">{copy.products}</a></div>
    </div>
    <nav aria-label={copy.navigationLabel} class="mx-auto mt-14 grid max-w-4xl gap-4 sm:grid-cols-3">{links.map((item) => <a href={item.href} class="rounded-panel border border-line-light bg-white p-7 hover:border-brand-400"><h2 class="text-lg font-bold text-ink">{item.title} <TablerIcon name="chevronRight" class="inline-block h-4 w-4 shrink-0 align-middle text-brand-600" /></h2><p class="mt-3 text-sm leading-7 text-copy">{item.text}</p></a>)}</nav>
  </section>
