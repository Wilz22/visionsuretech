---
import TablerIcon from "../ui/TablerIcon.astro";
import type {ServicesCopy} from '../../i18n/page-types';
import QuoteCta from '../ui/QuoteCta.astro';
import type {Messages} from '../../i18n/types';
interface Props {copy:ServicesCopy;assessmentHref:string;messages:Messages;quoteHref:string;}
const {copy,assessmentHref,messages,quoteHref}=Astro.props;
---
<section><h2 class="text-2xl font-bold text-ink">{copy.installation.title}</h2><p class="mt-4 leading-8 text-copy">{copy.installation.text}</p></section><section><h2 class="text-2xl font-bold text-ink">{copy.assessment.title}</h2><p class="mt-4 leading-8 text-copy">{copy.assessment.text}</p><a href={assessmentHref} class="mt-4 inline-flex min-h-12 items-center font-bold text-brand-600 gap-2">{copy.assessment.label} <TablerIcon name="chevronRight" class="inline-block h-4 w-4 shrink-0 align-middle" /></a></section><section><h2 class="text-2xl font-bold text-ink">{copy.financing.title}</h2><p class="mt-4 leading-8 text-copy">{copy.financing.text}</p></section><section><h2 class="text-2xl font-bold text-ink">{copy.related.title}</h2><ul class="mt-6 grid gap-4 sm:grid-cols-3">{copy.related.services.map(title=><li class="rounded-card border border-line-light p-6"><h3 class="font-bold text-ink">{title}</h3><p class="mt-3 text-sm leading-7 text-copy">{copy.related.pending}</p></li>)}</ul></section><QuoteCta copy={messages.quoteCta} label={messages.common.quote} href={quoteHref}/>