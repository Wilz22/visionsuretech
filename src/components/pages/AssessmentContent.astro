---
import TablerIcon from "../ui/TablerIcon.astro";
import type {AssessmentCopy} from '../../i18n/contact-types';
interface Props {copy:AssessmentCopy;bookingUrl:string|null;contactHref:string;}
const {copy,bookingUrl,contactHref}=Astro.props;
---
<section class="rounded-panel border border-line-light bg-white p-7 sm:p-9"><h2 class="text-2xl font-bold text-ink">{copy.heading}</h2><p class="mt-4 leading-8 text-copy">{copy.introduction}</p>{bookingUrl?<a href={bookingUrl} class="mt-7 inline-flex min-h-12 items-center rounded-pill bg-brand-500 px-6 font-bold text-white gap-2">{copy.calendarLabel} <TablerIcon name="chevronRight" class="inline-block h-4 w-4 shrink-0 align-middle" /></a>:<aside class="mt-6 rounded-card border border-line-brand bg-surface-brand p-6 text-sm leading-7 text-copy"><p class="font-bold text-brand-700">{copy.pendingHeading}</p><p>{copy.pendingText}</p><a href={contactHref} class="mt-4 inline-flex min-h-11 items-center font-bold text-brand-600 gap-2">{copy.contactLabel} <TablerIcon name="chevronRight" class="inline-block h-4 w-4 shrink-0 align-middle" /></a></aside>}</section>
