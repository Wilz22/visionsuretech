---
import type {RegulationCopy} from '../../i18n/page-types';
import {m217Review} from '../../data/regulatory-sources';
import TablerIcon from '../ui/TablerIcon.astro';
interface Props {copy:RegulationCopy;}
const {copy}=Astro.props;
---
<article class="mt-6 rounded-panel border border-line-light bg-white p-6 sm:p-8" aria-labelledby="m217-heading">
  <h3 id="m217-heading" class="text-xl font-bold text-ink">{copy.title}</h3>
  <p class="mt-4 border-l-4 border-brand-500 pl-4 font-semibold leading-7 text-brand-600">{copy.status}</p>
  <div class="mt-4 flex flex-wrap gap-x-6 gap-y-2 text-xs leading-6 text-copy"><p>{copy.reviewed}: <time datetime={m217Review.reviewedAt}>{m217Review.reviewedAt}</time></p><p>{copy.currency}: <time datetime={m217Review.consolidationCurrentTo}>{m217Review.consolidationCurrentTo}</time></p></div>
  <p class="mt-5 leading-8 text-copy">{copy.summary}</p>
  <details class="mt-6 border-y border-line-light py-4">
    <summary class="cursor-pointer py-2 font-bold leading-7 text-brand-600">{copy.requirementsTitle}</summary>
    <ul class="mt-4 list-disc space-y-3 pl-5 leading-7 text-copy">{copy.requirements.map(text=><li>{text}</li>)}</ul>
    <p class="mt-5 leading-7 text-copy">{copy.preparation}</p>
  </details>
  <h4 class="mt-6 text-sm font-bold text-ink">{copy.sourcesTitle}</h4>
  <ul class="mt-3 space-y-1">{m217Review.sources.map(source=><li><a href={source.href} class="inline-flex min-h-11 items-center gap-2 text-sm font-semibold leading-6 text-brand-600 hover:underline">{copy.sources[source.id]}<TablerIcon name="chevronRight" class="h-4 w-4 shrink-0"/></a></li>)}</ul>
  <p class="mt-5 text-sm leading-7 text-copy">{copy.notice}</p>
</article>
