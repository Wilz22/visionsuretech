---
import BaseLayout from '../../layouts/BaseLayout.astro';
import type { LegalDocument } from '../../data/legal';
interface Props { document: LegalDocument; }
const { document } = Astro.props;
const reference = document.status === 'reference';
---

<BaseLayout title={document.title} description={document.description} noindex={reference} image="/images/solutions/vst-s6301.jpg">
  <section class="border-b border-line-light pt-10 pb-14 sm:pb-16">
    <div class="container">
      <nav aria-label="Breadcrumb" class="text-sm text-copy"><ol class="flex flex-wrap gap-3"><li><a href="/" class="hover:text-brand-600">Home</a></li><li aria-hidden="true">/</li><li aria-current="page">{document.title}</li></ol></nav>
      <p class="mt-12 text-xs font-extrabold tracking-widest text-brand-600 uppercase">Website information</p>
      <h1 class="mt-5 text-4xl font-bold leading-tight tracking-[-0.045em] text-ink sm:text-6xl">{document.title}</h1>
      <p class="mt-5 text-sm text-copy">{document.effectiveDate ? `Effective date: ${document.effectiveDate}` : 'Effective date: to be confirmed'}</p>
      {reference && <aside class="mt-7 max-w-3xl rounded-card border border-line-brand bg-surface-brand p-6"><h2 class="text-sm font-bold text-brand-700">Reference draft · Pending client review</h2><p class="mt-2 text-sm leading-7 text-copy">This page contains reference wording and clearly marked fields to complete. It is not the final approved legal document. Company details, business practices and applicable requirements must be confirmed before publication.</p></aside>}
    </div>
  </section>
  <div class="container grid items-start gap-10 py-14 lg:grid-cols-[0.55fr_1.45fr] lg:gap-20 sm:py-16">
    <nav aria-label="On this page" class="rounded-panel border border-line-light bg-white p-6 lg:sticky lg:top-28"><h2 class="text-sm font-bold text-ink">On this page</h2><ol class="mt-4 space-y-1">{document.sections.map((section, index) => <li><a href={`#${section.id}`} class="flex min-h-11 items-start gap-3 py-2 text-sm leading-6 text-copy hover:text-brand-600"><span class="font-bold text-brand-600">{String(index + 1).padStart(2, '0')}</span>{section.title}</a></li>)}</ol></nav>
    <div class="min-w-0 space-y-10">{document.sections.map((section, index) => <section id={section.id} aria-labelledby={`${section.id}-heading`} class="scroll-mt-28 border-b border-line-light pb-10"><h2 id={`${section.id}-heading`} class="text-2xl font-bold leading-tight tracking-tight text-ink">{index + 1}. {section.title}</h2>{section.paragraphs.map((paragraph) => <p class="mt-4 leading-8 text-copy">{paragraph}</p>)}{section.pending && <div class="mt-5 rounded-card border border-dashed border-line-brand bg-white p-5"><p class="text-xs font-extrabold tracking-wide text-brand-600 uppercase">To be completed</p><ul class="mt-3 space-y-2">{section.pending.map((item) => <li class="flex gap-3 text-sm leading-7 text-copy"><span class="mt-2.5 h-1.5 w-1.5 shrink-0 rounded-full bg-brand-500" aria-hidden="true" />{item}</li>)}</ul></div>}</section>)}<a href="/contact" class="inline-flex min-h-12 items-center gap-3 rounded-pill border border-line-medium bg-white px-6 py-3 text-sm font-bold text-brand-600 hover:border-brand-500">Contact information <span aria-hidden="true">→</span></a></div>
  </div>
</BaseLayout>
