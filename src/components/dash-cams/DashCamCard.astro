---
import TablerIcon from "../ui/TablerIcon.astro";
import type {DashCam} from '../../data/dashCams';
import {getMessages} from '../../i18n';
import type {DashCamCardCopy} from '../../i18n/catalog-types';
interface Props {model:DashCam;copy?:DashCamCardCopy;href?:string}
const {model,copy=getMessages().dashCamCard,href=`/dash-cams/${model.slug}/`}=Astro.props;
---
<article class="flex h-full flex-col rounded-panel border border-line-light bg-white p-7"><div class="flex h-40 items-center justify-center rounded-card bg-surface-brand text-brand-600"><svg aria-hidden="true" viewBox="0 0 100 64" class="h-20 w-32" fill="none" stroke="currentColor" stroke-width="2"><rect x="10" y="10" width="80" height="44" rx="8"/><circle cx="65" cy="32" r="13"/><rect x="20" y="23" width="21" height="18" rx="3"/></svg></div><p class="mt-5 text-xs font-bold text-brand-600">{copy.reference}</p><h3 class="mt-3 text-xl font-bold text-ink"><a href={href}>{model.title}</a></h3><p class="mt-3 text-sm leading-7 text-copy">{model.configuration}</p><a href={href} class="mt-auto inline-flex min-h-12 items-center pt-5 text-sm font-bold text-brand-600 gap-2">{copy.viewDetails} <TablerIcon name="chevronRight" class="inline-block h-4 w-4 shrink-0 align-middle" /></a></article>
