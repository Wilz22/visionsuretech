---
const navItems = [
  {
    label: "Solutions",
    href: "/solutions",
  },
  {
    label: "Industries",
    href: "/industries",
  },
  {
    label: "Projects",
    href: "/projects",
  },
  {
    label: "About",
    href: "/about",
  },
  {
    label: "FAQ",
    href: "/faq",
  },
];

const currentPath = Astro.url.pathname;

const isActive = (href: string) => {
  if (href === "/") {
    return currentPath === "/";
  }

  return currentPath.startsWith(href);
};

const buttonClasses =
  "group inline-flex items-center justify-center gap-[10px] rounded-pill border border-transparent bg-brand-500 px-[22px] py-3 font-bold text-inverse shadow-soft transition-[background-color,color,border-color,transform,box-shadow] duration-[250ms] hover:-translate-y-px hover:bg-brand-600 hover:shadow-raised motion-reduce:transition-none";

const desktopNavLinkClasses =
  "relative inline-flex min-h-11 items-center text-[0.9375rem] font-semibold transition-colors duration-[250ms] after:absolute after:bottom-0.5 after:left-1/2 after:h-0.5 after:w-0 after:-translate-x-1/2 after:rounded-pill after:bg-brand-500 after:transition-[width] after:duration-[250ms] hover:text-brand-600 hover:after:w-[22px] motion-reduce:transition-none motion-reduce:after:transition-none";

const mobileNavLinkClasses =
  "flex items-center border-b border-line-light px-1 py-[15px] text-[1.0625rem] font-semibold text-ink transition-colors duration-[250ms] hover:text-brand-600 motion-reduce:transition-none";
---

<header
  class="sticky top-0 z-100 border-b border-transparent bg-[rgba(247,247,245,0.94)] backdrop-blur-lg transition-[background-color,border-color,box-shadow] duration-250 [&.scrolled]:border-line-light [&.scrolled]:bg-white/96 [&.scrolled]:shadow-[0_4px_20px_rgba(24,32,39,0.04)] motion-reduce:transition-none"
  data-header
>
  <div class="container">
    <div
      class="flex min-h-21.5 items-center gap-8 max-[1023px]:min-h-19 max-[480px]:min-h-17.5"
    >
      <a
        href="/"
        class="inline-flex shrink-0 items-center"
        aria-label="VisionSure Technologies - Home"
      >
        <img
          class="h-18.5 w-60 object-contain max-[1023px]:h-12.5 max-[480px]:h-10.75 max-[480px]:w-44"
          src="/images/brand/visionsure-logo.svg"
          alt="VisionSure Technologies"
          loading="eager"
        />
      </a>

      <nav
        class="flex flex-1 justify-center max-[1023px]:hidden"
        aria-label="Primary navigation"
      >
        <ul
          class="m-0 flex list-none items-center gap-7.5 p-0 max-[1100px]:gap-5"
        >
          {
            navItems.map((item) => (
              <li>
                <a
                  href={item.href}
                  class:list={[
                    desktopNavLinkClasses,
                    { active: isActive(item.href) },
                    isActive(item.href)
                      ? "text-brand-600 after:w-5.5"
                      : "text-copy",
                  ]}
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div
        class="flex shrink-0 items-center gap-5.5 max-[1100px]:gap-3.5 max-[1023px]:hidden"
      >
        <a
          href="/contact"
          class="text-[0.9375rem] font-semibold text-copy transition-colors duration-250 hover:text-brand-600 max-[1100px]:hidden motion-reduce:transition-none"
        >
          Contact
        </a>

        <a
          href="/contact#quote"
          class:list={[buttonClasses, "min-h-11.5 px-5 text-[0.9rem]"]}
        >
          Request a Quote

          <svg
            class="h-4.5 w-4.5 transition-transform duration-250 group-hover:translate-x-0.75 motion-reduce:transition-none"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path
              d="M5 12h14M13 6l6 6-6 6"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
        </a>
      </div>

      <button
        class="group ml-auto hidden h-11.5 w-11.5 flex-col items-center justify-center gap-1.25 rounded-control border border-line-light bg-surface p-0 shadow-soft max-[1023px]:flex max-[480px]:h-10.5 max-[480px]:w-10.5"
        type="button"
        aria-label="Open navigation menu"
        aria-expanded="false"
        aria-controls="mobile-navigation"
        data-menu-toggle
      >
        <span
          class="block h-0.5 w-4.75 rounded-pill bg-ink transition-[transform,opacity] duration-250 group-[.open]:translate-y-1.75 group-[.open]:rotate-45 motion-reduce:transition-none"
        ></span>
        <span
          class="block h-0.5 w-4.75 rounded-pill bg-ink transition-[transform,opacity] duration-250 group-[.open]:opacity-0 motion-reduce:transition-none"
        ></span>
        <span
          class="block h-0.5 w-4.75 rounded-pill bg-ink transition-[transform,opacity] duration-250 group-[.open]:-translate-y-1.75 group-[.open]:-rotate-45 motion-reduce:transition-none"
        ></span>
      </button>
    </div>
  </div>

  <div
    id="mobile-navigation"
    class="hidden max-h-0 overflow-hidden bg-surface opacity-0 transition-[max-height,opacity] duration-350 [&.open]:max-h-175 [&.open]:opacity-100 max-[1023px]:block motion-reduce:transition-none"
    data-mobile-menu
  >
    <div class="container">
      <nav aria-label="Mobile navigation">
        <ul class="m-0 flex list-none flex-col gap-0 pt-3.5 pb-5">
          {
            navItems.map((item) => (
              <li>
                <a
                  href={item.href}
                  class:list={[
                    mobileNavLinkClasses,
                    {
                      active: isActive(item.href),
                      "text-brand-600": isActive(item.href),
                    },
                  ]}
                >
                  {item.label}
                </a>
              </li>
            ))
          }

          <li>
            <a href="/contact" class={mobileNavLinkClasses}> Contact </a>
          </li>
        </ul>

        <a href="/contact#quote" class:list={[buttonClasses, "mb-6 w-full"]}>
          Request a Quote

          <svg
            class="h-4.5 w-4.5 transition-transform duration-250 group-hover:translate-x-0.75 motion-reduce:transition-none"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path
              d="M5 12h14M13 6l6 6-6 6"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
        </a>
      </nav>
    </div>
  </div>
</header>

<script>
  const header = document.querySelector("[data-header]");
  const menuToggle = document.querySelector("[data-menu-toggle]");
  const mobileMenu = document.querySelector("[data-mobile-menu]");

  if (
    header instanceof HTMLElement &&
    menuToggle instanceof HTMLButtonElement &&
    mobileMenu instanceof HTMLElement
  ) {
    const closeMenu = () => {
      menuToggle.setAttribute("aria-expanded", "false");
      menuToggle.setAttribute("aria-label", "Open navigation menu");

      mobileMenu.classList.remove("open");
      menuToggle.classList.remove("open");

      document.body.classList.remove("menu-open", "overflow-hidden");
    };

    const openMenu = () => {
      menuToggle.setAttribute("aria-expanded", "true");
      menuToggle.setAttribute("aria-label", "Close navigation menu");

      mobileMenu.classList.add("open");
      menuToggle.classList.add("open");

      document.body.classList.add("menu-open", "overflow-hidden");
    };

    menuToggle.addEventListener("click", () => {
      const expanded = menuToggle.getAttribute("aria-expanded") === "true";

      if (expanded) {
        closeMenu();
      } else {
        openMenu();
      }
    });

    mobileMenu.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", closeMenu);
    });

    window.addEventListener("resize", () => {
      if (window.innerWidth >= 1024) {
        closeMenu();
      }
    });

    window.addEventListener("scroll", () => {
      if (window.scrollY > 10) {
        header.classList.add("scrolled");
      } else {
        header.classList.remove("scrolled");
      }
    });
  }
</script>
