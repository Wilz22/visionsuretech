---
import {buildNavigation, type NavigationItem} from '../../lib/navigation';
import {getMessages,formatMessage} from '../../i18n';
import {locales,defaultLocale,type Locale} from '../../i18n/config';
import type {Messages} from '../../i18n/types';
import {company} from '../../data/company';
import TablerIcon from "../ui/TablerIcon.astro";
interface Props {locale?:Locale;copy?:Messages['navigation'];navigation?:NavigationItem[];homeLabel?:string;homeHref?:string;languageOptions?:readonly {code:string;label:string;enabled:boolean}[];}
const {locale=defaultLocale,copy=getMessages(locale).navigation,navigation=buildNavigation(copy).main,homeLabel=formatMessage(getMessages(locale).common.homeLink,{company:company.name}),homeHref='/',languageOptions=locales}=Astro.props;
const selectedLanguage=languageOptions.find(language=>language.code===locale)!;
const current = Astro.url.pathname.replace(/\/$/, "") || "/";
const active = (href: string) => current === (href.replace(/\/$/, "") || "/");
---

<header
  id="site-header"
  class="sticky top-0 z-50 border-b border-line-light bg-page/95 backdrop-blur"
>
  <div
    class="container flex flex-wrap items-center justify-between gap-x-3 py-3.5 xl:gap-x-4"
  >
    <a
      href={homeHref}
      aria-label={homeLabel}
      class="relative order-1 block h-12 w-32 shrink-0 overflow-hidden sm:w-40 xl:w-44"
    >
      <img
        src="/images/brand/visionsure-logo.svg"
        alt={company.name}
        width="216"
        height="90"
        class="absolute top-1/2 left-0 h-auto w-full -translate-y-1/2"
      />
    </a>
    <nav
      id="primary-menu"
      aria-label={copy.primaryLabel}
      class="order-3 max-h-[calc(100dvh-5rem)] w-full overflow-y-auto pt-4 pb-3 xl:order-2 xl:flex xl:max-h-none xl:w-auto xl:flex-1 xl:justify-center xl:overflow-visible xl:py-0"
    >
      <ul class="flex flex-col gap-1 xl:flex-row xl:items-center xl:gap-0">
        {
          navigation.map((item, index) => (
            <li>
              {item.children ? (
                <button
                  hidden
                  id={`nav-trigger-${index}`}
                  type="button"
                  class:list={[
                    "nav-option nav-mega-trigger group flex min-h-11 w-full items-center justify-between gap-2 rounded-control px-3 text-sm font-semibold transition-colors duration-250 xl:w-auto xl:px-2 xl:text-[13px]",
                    active(item.href) ||
                    item.children.some((child) => active(child.href))
                      ? "bg-brand-50 text-brand-700"
                      : "text-copy max-xl:hover:bg-brand-50 hover:text-brand-600",
                  ]}
                  aria-expanded="false"
                  aria-controls={`nav-dropdown-${index}`}
                  aria-label={formatMessage(copy.showLinks,{section:item.label})}
                >
                  <span>{item.label}</span>
                  <TablerIcon
                    name="chevronRight"
                    class="h-4 w-4 shrink-0 rotate-90 transition-transform group-aria-expanded:-rotate-90 motion-reduce:transition-none"
                  />
                </button>
              ) : (
                <a
                  href={item.href}
                  aria-current={active(item.href) ? "page" : undefined}
                  class:list={[
                    "nav-option flex min-h-11 items-center rounded-control px-3 text-sm font-semibold transition-colors duration-250 xl:px-2 xl:text-[13px]",
                    active(item.href)
                      ? "bg-brand-50 text-brand-700"
                      : "text-copy max-xl:hover:bg-brand-50 hover:text-brand-600",
                  ]}
                >
                  {item.label}
                </a>
              )}
              {item.children && (
                <div
                  id={`nav-dropdown-${index}`}
                  class="nav-mega-panel my-1 rounded-control border border-line-light bg-brand-50/50 p-2 xl:absolute xl:inset-x-0 xl:top-full xl:my-0 xl:rounded-none xl:border-x-0 xl:bg-page xl:px-0 xl:py-6 xl:shadow-raised"
                >
                  <div class="xl:container xl:grid xl:grid-cols-[240px_1fr] xl:gap-8">
                    <a
                      href={item.href}
                      class="mb-1 flex min-h-11 items-center justify-between gap-3 rounded-control px-3 py-2 text-sm font-bold text-brand-700 hover:bg-brand-50 xl:mb-0 xl:items-start xl:py-3 xl:text-lg"
                    >
                      <span>{formatMessage(copy.explore,{section:item.label})}</span>
                      <TablerIcon
                        name="chevronRight"
                        class="mt-0.5 h-5 w-5 shrink-0"
                      />
                    </a>
                    <ul
                      class="grid gap-1 sm:grid-cols-2 xl:grid-cols-3"
                      aria-labelledby={`nav-trigger-${index}`}
                    >
                      {item.children.map((child) => (
                        <li>
                          <a
                            href={child.href}
                            class="flex min-h-11 items-center rounded-control px-3 py-2 text-sm text-copy hover:bg-white hover:text-brand-700"
                            aria-current={
                              active(child.href) ? "page" : undefined
                            }
                          >
                            {child.label}
                          </a>
                        </li>
                      ))}
                    </ul>
                  </div>
                </div>
              )}
            </li>
          ))
        }
      </ul>
    </nav>
    <div class="order-2 flex shrink-0 items-center gap-2 xl:order-3">
      <button
        id="language-toggle"
        hidden
        type="button"
        aria-label={formatMessage(copy.languageLabel,{language:selectedLanguage.label})}
        aria-controls="language-menu"
        aria-expanded="false"
        class="inline-flex min-h-11 items-center justify-center gap-1.5 rounded-control px-2 text-sm font-semibold text-brand-700 hover:bg-brand-50"
      >
        <TablerIcon name="world" class="h-5 w-5" /><span>{selectedLanguage.code.toUpperCase()}</span><TablerIcon
          name="chevronRight"
          class="hidden h-3.5 w-3.5 rotate-90 sm:block"
        />
      </button>
      <button
        id="navigation-toggle"
        hidden
        type="button"
        aria-controls="primary-menu"
        aria-expanded="false"
        aria-label={copy.openMenu}
        data-open-label={copy.openMenu}
        data-close-label={copy.closeMenu}
        class="group inline-flex h-11 w-11 items-center justify-center rounded-control border border-line-medium text-brand-600 hover:bg-brand-50 xl:hidden!"
      >
        <TablerIcon
          name="menu"
          class="h-6 w-6 group-aria-expanded:hidden"
        /><TablerIcon
          name="close"
          class="hidden h-6 w-6 group-aria-expanded:block"
        />
      </button>
      <div
        id="language-menu"
        class="hidden z-50 w-60 rounded-card border border-line-light bg-white p-2 shadow-raised"
        aria-labelledby="language-toggle"
      >
        <p
          class="px-3 py-2 text-xs font-semibold uppercase tracking-wider text-copy"
        >
          {copy.language}
        </p>
        <ul class="text-sm">
          {languageOptions.map(language=><li><button type="button" id={language.code===selectedLanguage.code?'language-active':undefined} aria-current={language.code===selectedLanguage.code?'true':undefined} disabled={!language.enabled} class:list={['flex min-h-11 w-full items-center justify-between gap-3 rounded-control px-3 text-left',language.code===selectedLanguage.code?'bg-brand-50 font-semibold text-brand-700':'text-copy/60']}><span lang={language.code}>{language.label}</span>{language.code===selectedLanguage.code?<TablerIcon name="check" class="h-4 w-4"/>:<span class="text-xs">{copy.comingSoon}</span>}</button></li>)}
        </ul>
      </div>
    </div>
  </div>
</header>
<style>
  @media (min-width: 1280px) {
    .nav-option {
      position: relative;
    }

    .nav-option::after {
      content: "";
      position: absolute;
      bottom: 0.125rem;
      left: 50%;
      width: 0;
      height: 0.125rem;
      transform: translateX(-50%);
      border-radius: 9999px;
      background: var(--color-brand-500);
      transition: width 250ms;
    }

    .nav-option:hover,
    .nav-option:focus-visible {
      color: var(--color-brand-600);
    }

    .nav-option:hover::after,
    .nav-option:focus-visible::after {
      width: 22px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .nav-option,
    .nav-option::after {
      transition: none;
    }
  }
</style>
<script>
  import Collapse from "flowbite/lib/esm/components/collapse";
  import Dropdown from "flowbite/lib/esm/components/dropdown";
  const header = document.querySelector<HTMLElement>("#site-header")!;
  const trigger =
    document.querySelector<HTMLButtonElement>("#navigation-toggle")!;
  const menu = document.querySelector<HTMLElement>("#primary-menu")!;
  const desktop = matchMedia("(min-width:1280px)");
  const panels: Array<{
    instance: Collapse;
    button: HTMLButtonElement;
    panel: HTMLElement;
  }> = [];
  const closePanels = () => panels.forEach((item) => item.instance.collapse());
  trigger.hidden = false;
  trigger.setAttribute("aria-expanded", String(desktop.matches));
  if (!desktop.matches) menu.classList.add("hidden");
  const navigation = new Collapse(menu, trigger, {
    onExpand: () => trigger.setAttribute("aria-label", trigger.dataset.closeLabel!),
    onCollapse: () => {
      trigger.setAttribute("aria-label", trigger.dataset.openLabel!);
      closePanels();
    },
  });
  document
    .querySelectorAll<HTMLButtonElement>(".nav-mega-trigger")
    .forEach((button) => {
      button.hidden = false;
      const panel = document.getElementById(
        button.getAttribute("aria-controls")!,
      )!;
      panel.classList.add("hidden");
      const instance = new Collapse(panel, button, {
        onExpand: () => {
          panels.forEach((other) => {
            if (other.button !== button) other.instance.collapse();
          });
          language.hide();
        },
      });
      panels.push({ instance, button, panel });
      button.addEventListener("keydown", (event) => {
        if (event.key === "ArrowDown") {
          event.preventDefault();
          instance.expand();
          panel.querySelector<HTMLAnchorElement>("a")?.focus();
        }
      });
      panel.addEventListener("keydown", (event) => {
        const links = [...panel.querySelectorAll<HTMLAnchorElement>("a")];
        const index = links.indexOf(
          document.activeElement as HTMLAnchorElement,
        );
        if (event.key === "ArrowDown" || event.key === "ArrowUp") {
          event.preventDefault();
          links[
            (index + (event.key === "ArrowDown" ? 1 : -1) + links.length) %
              links.length
          ]?.focus();
        }
      });
    });
  const languageTrigger =
    document.querySelector<HTMLButtonElement>("#language-toggle")!;
  languageTrigger.hidden = false;
  const language = new Dropdown(
    document.querySelector<HTMLElement>("#language-menu")!,
    languageTrigger,
    {
      placement: "bottom-end",
      triggerType: "click",
      onShow: () => {
        closePanels();
        languageTrigger.setAttribute("aria-expanded", "true");
      },
      onHide: () => languageTrigger.setAttribute("aria-expanded", "false"),
    },
  );
  document.querySelector("#language-active")!.addEventListener("click", () => {
    language.hide();
    languageTrigger.focus();
  });
  languageTrigger.addEventListener("keydown", (event) => {
    if (event.key === "ArrowDown") {
      event.preventDefault();
      language.show();
      document.querySelector<HTMLButtonElement>("#language-active")!.focus();
    }
  });
  document.addEventListener("click", (event) => {
    if (desktop.matches && !header.contains(event.target as Node))
      closePanels();
  });
  document.addEventListener("keydown", (event) => {
    if (event.key !== "Escape") return;
    if (language.isVisible()) {
      language.hide();
      languageTrigger.focus();
      return;
    }
    const open = panels.find(
      (item) => item.button.getAttribute("aria-expanded") === "true",
    );
    if (open) {
      open.instance.collapse();
      open.button.focus();
    } else if (!desktop.matches && !menu.classList.contains("hidden")) {
      navigation.collapse();
      trigger.focus();
    }
  });
  desktop.addEventListener("change", () => {
    closePanels();
    language.hide();
    if (desktop.matches) navigation.expand();
    else navigation.collapse();
  });
</script>
