---
const currentYear = new Date().getFullYear();

const solutionLinks = [
  {
    label: "AI Dashcam Systems",
    href: "/solutions/ai-dashcam",
  },
  {
    label: "Wireless Boom Tip Cameras",
    href: "/solutions/wireless-boom-tip-camera",
  },
  {
    label: "Wired Camera Systems",
    href: "/solutions/wired-camera-systems",
  },
  {
    label: "Wireless Camera Systems",
    href: "/solutions/wireless-camera-systems",
  },
  {
    label: "77GHz Radar Detection",
    href: "/solutions/77ghz-radar-detection",
  },
  {
    label: "360Â° Around View",
    href: "/solutions/360-around-view",
  },
];

const companyLinks = [
  {
    label: "About Us",
    href: "/about",
  },
  {
    label: "Industries",
    href: "/industries",
  },
  {
    label: "Projects",
    href: "/projects",
  },
  {
    label: "FAQ",
    href: "/faq",
  },
  {
    label: "Contact",
    href: "/contact",
  },
];

const legalLinks = [
  {
    label: "Privacy Policy",
    href: "/privacy-policy",
  },
  {
    label: "Terms of Use",
    href: "/terms",
  },
];

const buttonClasses =
  "group inline-flex items-center justify-center gap-[10px] rounded-pill border border-transparent bg-brand-500 py-3 font-bold text-inverse shadow-soft transition-[background-color,color,border-color,transform,box-shadow] duration-[250ms] hover:-translate-y-px hover:bg-brand-600 hover:shadow-raised motion-reduce:transition-none";

const footerLinkClasses =
  "text-[0.9375rem] leading-normal text-copy transition-colors duration-[250ms] hover:text-brand-600 motion-reduce:transition-none";
---

<footer class="mt-0">
  <section
    class="relative z-2 bg-page pt-12 pb-12 max-[600px]:pt-14 max-[600px]:pb-8"
  >
    <div class="mx-auto w-[min(calc(100%-40px),80rem)]">
      <div
        class="relative grid grid-cols-[minmax(0,1fr)_auto] items-center gap-12 overflow-hidden rounded-panel border border-brand-500/12 bg-[linear-gradient(135deg,var(--color-surface-brand),#fff)] px-16 py-14 shadow-raised after:pointer-events-none after:absolute after:-top-30 after:-right-25 after:h-70 after:w-70 after:rounded-full after:bg-brand-500/6 after:content-[''] max-[850px]:grid-cols-1 max-[850px]:gap-7.5 max-[850px]:p-12 max-[600px]:rounded-card max-[600px]:px-7 max-[600px]:py-9"
      >
        <div class="relative z-1 max-w-162.5">
          <p
            class="mb-3.5 text-[0.8125rem] font-bold tracking-[0.12em] text-brand-600 uppercase"
          >
            Let&apos;s improve visibility
          </p>

          <h2
            class="m-0 max-w-150 text-[clamp(2rem,4vw,3.25rem)] leading-[1.08] font-bold tracking-[-0.035em] text-ink"
          >
            Ready to make your operations safer?
          </h2>

          <p class="mt-5 max-w-147.5 text-[1.0625rem] leading-[1.7] text-copy">
            Talk with VisionSure Technologies about the right camera, radar or
            visibility solution for your equipment.
          </p>
        </div>

        <a
          href="/contact#quote"
          class:list={[
            buttonClasses,
            "relative z-1 min-h-13.5 shrink-0 px-6.5 max-[850px]:justify-self-start max-[600px]:w-full",
          ]}
        >
          Request a Quote

          <svg
            class="h-4.5 w-4.5 transition-transform duration-250 group-hover:translate-x-0.75 motion-reduce:transition-none"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path
              d="M5 12h14M13 6l6 6-6 6"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
            </path>
          </svg>
        </a>
      </div>
    </div>
  </section>

  <div
    class="border-t border-line-light bg-[#eef1f2] pt-20 pb-8 max-[600px]:pt-14"
  >
    <div class="mx-auto w-[min(calc(100%-40px),80rem)]">
      <div
        class="grid grid-cols-[1.7fr_1fr_0.8fr_1fr] gap-14 max-[1050px]:grid-cols-[1.4fr_1fr_1fr] max-[1050px]:gap-12 max-[850px]:grid-cols-2 max-[600px]:grid-cols-1 max-[600px]:gap-10.5"
      >
        <div
          class="max-w-97.5 max-[850px]:col-span-full max-[850px]:max-w-135 max-[600px]:col-auto"
        >
          <a
            href="/"
            class="inline-flex items-center"
            aria-label="VisionSure Technologies - Home"
          >
            <img
              class="h-15 w-auto object-contain"
              src="/images/brand/visionsure-logo.svg"
              alt="VisionSure Technologies"
              loading="lazy"
            />
          </a>

          <p class="mt-6.5 mb-5.5 text-[0.9375rem] leading-[1.75] text-copy">
            Advanced camera, radar and AI-powered safety solutions designed to
            improve visibility around heavy equipment and industrial operations.
          </p>

          <a
            href="/contact"
            class="group inline-flex items-center gap-2 font-bold text-brand-600 transition-colors duration-250 hover:text-brand-700 motion-reduce:transition-none"
          >
            Contact VisionSure
            <span
              class="transition-transform duration-250 group-hover:translate-x-1 motion-reduce:transition-none"
              aria-hidden="true">&rarr;</span
            >
          </a>
        </div>

        <div>
          <h3
            class="mt-1.5 mb-5.5 text-sm font-extrabold tracking-[0.07em] text-ink uppercase"
          >
            Solutions
          </h3>

          <ul class="m-0 flex list-none flex-col gap-3 p-0">
            {
              solutionLinks.map((item) => (
                <li class="m-0">
                  <a href={item.href} class={footerLinkClasses}>
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>

        <div>
          <h3
            class="mt-1.5 mb-5.5 text-sm font-extrabold tracking-[0.07em] text-ink uppercase"
          >
            Company
          </h3>

          <ul class="m-0 flex list-none flex-col gap-3 p-0">
            {
              companyLinks.map((item) => (
                <li class="m-0">
                  <a href={item.href} class={footerLinkClasses}>
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>

        <div
          class="max-[1050px]:col-[2/-1] max-[850px]:col-auto max-[600px]:col-auto"
        >
          <h3
            class="mt-1.5 mb-5.5 text-sm font-extrabold tracking-[0.07em] text-ink uppercase"
          >
            Get in touch
          </h3>

          <p class="mb-5 text-[0.9375rem] leading-[1.7] text-copy">
            Have a project or equipment safety requirement? Let&apos;s talk.
          </p>

          <a
            href="/contact"
            class="group inline-flex items-center gap-2 text-[0.9375rem] font-bold text-brand-600 transition-colors duration-250 hover:text-brand-700 motion-reduce:transition-none"
          >
            Contact us
            <span
              class="transition-transform duration-250 group-hover:translate-x-1 motion-reduce:transition-none"
              aria-hidden="true"
            >
              &rarr;
            </span>
          </a>
        </div>
      </div>

      <div
        class="mt-16 flex items-center justify-between gap-6 border-t border-line-medium pt-7 max-[600px]:mt-12 max-[600px]:flex-col max-[600px]:items-start"
      >
        <p class="text-[0.8125rem] text-muted">
          &copy; {currentYear} VisionSure Technologies. All rights reserved.
        </p>

        <nav
          class="flex items-center gap-6 max-[600px]:flex-wrap max-[600px]:gap-x-5 max-[600px]:gap-y-2.5"
          aria-label="Legal navigation"
        >
          {
            legalLinks.map((item) => (
              <a
                href={item.href}
                class="text-[0.8125rem] text-muted transition-colors duration-250 hover:text-brand-600 motion-reduce:transition-none"
              >
                {item.label}
              </a>
            ))
          }
        </nav>
      </div>
    </div>
  </div>
</footer>
