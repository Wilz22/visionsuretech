---
import BaseLayout from '../layouts/BaseLayout.astro';
import IndustryIcon from '../components/industries/IndustryIcon.astro';
import IndustrySystemLink from '../components/industries/IndustrySystemLink.astro';
import { getIndustryCatalog } from '../lib/industries';

const industries = await getIndustryCatalog();
const breadcrumbs = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', Astro.site).href },
    { '@type': 'ListItem', position: 2, name: 'Industries', item: new URL('/industries', Astro.site).href },
  ],
};
---

<BaseLayout title="Industries & Equipment Applications" description="Explore camera, recording, radar and fleet monitoring systems for cranes, mining, construction, ports, heavy equipment and commercial fleets." image="/images/home/hero-industrial-visibility.webp">
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(breadcrumbs).replace(/</g, '\\u003c')} />

  <section class="border-b border-line-light bg-page pt-10 pb-16 sm:pb-20">
    <div class="container">
      <nav aria-label="Breadcrumb" class="mb-12 text-sm text-copy">
        <ol class="flex flex-wrap gap-3"><li><a href="/" class="hover:text-brand-600">Home</a></li><li aria-hidden="true">/</li><li aria-current="page">Industries</li></ol>
      </nav>
      <div class="grid gap-8 lg:grid-cols-[1.15fr_0.85fr] lg:items-end lg:gap-16">
        <div>
          <p class="text-xs font-extrabold tracking-[0.14em] text-brand-600 uppercase">Industries & applications</p>
          <h1 class="mt-5 max-w-3xl text-4xl leading-[1.05] font-bold tracking-[-0.045em] text-ink sm:text-6xl">Your operation.<br />A clearer view.</h1>
        </div>
        <div>
          <p class="max-w-xl text-lg leading-8 text-copy">Start with the work you do. Explore visibility, recording and detection systems by industry, then find the features that fit your equipment and daily tasks.</p>
          <a href="/solutions" class="mt-6 inline-flex min-h-11 items-center gap-3 text-sm font-bold text-brand-600 hover:text-brand-800">Compare all eight systems <span aria-hidden="true">→</span></a>
        </div>
      </div>

      <nav aria-label="Industries" class="mt-12">
        <ul class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
          {industries.map((industry) => (
            <li><a href={`#${industry.id}`} class="group flex h-full items-center gap-4 rounded-card border border-line-light bg-white p-5 shadow-soft transition-colors hover:border-brand-400">
              <IndustryIcon industry={industry.id} class="h-12 w-12 shrink-0 text-brand-600" />
              <span class="min-w-0 flex-1"><span class="block text-xs font-bold tracking-widest text-brand-600">{industry.number}</span><span class="mt-1 block text-sm font-bold text-ink">{industry.title}</span></span>
              <span aria-hidden="true" class="text-brand-600">↓</span>
            </a></li>
          ))}
        </ul>
      </nav>
    </div>
  </section>

  <div class="container divide-y divide-line-light">
    {industries.map((industry) => (
      <section id={industry.id} aria-labelledby={`${industry.id}-heading`} class="scroll-mt-28 py-16 sm:py-20">
        <div class="grid gap-10 lg:grid-cols-[0.9fr_1.1fr] lg:gap-20">
          <div>
            <div class="flex items-center gap-4">
              <span class="flex h-16 w-16 items-center justify-center rounded-card bg-surface-brand"><IndustryIcon industry={industry.id} class="h-12 w-12 text-brand-600" /></span>
              <p class="text-xs font-extrabold tracking-widest text-brand-600 uppercase">{industry.number} / {industry.label}</p>
            </div>
            <h2 id={`${industry.id}-heading`} class="mt-6 text-3xl leading-tight font-bold tracking-[-0.035em] text-ink sm:text-4xl">{industry.title}</h2>
            <p class="mt-5 max-w-xl leading-8 text-copy">{industry.overview}</p>
            <div class="mt-8 rounded-card border border-line-light bg-surface-soft p-6 sm:p-7">
              <h3 class="text-sm font-bold text-ink">What to focus on</h3>
              <ul class="mt-4 space-y-4">
                {industry.needs.map((need) => <li class="flex gap-3 text-sm leading-7 text-copy"><span class="mt-2.5 h-1.5 w-1.5 shrink-0 rounded-full bg-brand-500" aria-hidden="true" />{need}</li>)}
              </ul>
            </div>
          </div>
          <div>
            <p class="mb-5 text-xs font-extrabold tracking-widest text-brand-600 uppercase">Systems to explore</p>
            <ul class="grid gap-4">
              {industry.systems.map(({ solution, reason }) => <li><IndustrySystemLink solution={solution} reason={reason} /></li>)}
            </ul>
          </div>
        </div>
      </section>
    ))}
  </div>

  <section class="bg-surface-brand py-16 sm:py-20" aria-labelledby="selection-heading">
    <div class="container">
      <div class="max-w-2xl">
        <p class="text-xs font-extrabold tracking-widest text-brand-600 uppercase">From application to configuration</p>
        <h2 id="selection-heading" class="mt-4 text-3xl leading-tight font-bold tracking-tight text-ink sm:text-4xl">Start with your equipment.</h2>
        <p class="mt-5 leading-8 text-copy">These systems are starting points for your application. The final configuration depends on the machine, mounting positions, power supply and operating environment.</p>
      </div>
      <ol class="mt-8 grid gap-5 md:grid-cols-3">
        <li class="rounded-card bg-white p-7"><span class="text-xs font-bold text-brand-600">01</span><h3 class="mt-3 text-lg font-bold text-ink">Identify the view</h3><p class="mt-3 text-sm leading-7 text-copy">Note the blind spots, manoeuvres and work areas the operator needs to see.</p></li>
        <li class="rounded-card bg-white p-7"><span class="text-xs font-bold text-brand-600">02</span><h3 class="mt-3 text-lg font-bold text-ink">Choose the function</h3><p class="mt-3 text-sm leading-7 text-copy">Decide whether you need live visibility, recorded footage, proximity alerts or remote access.</p></li>
        <li class="rounded-card bg-white p-7"><span class="text-xs font-bold text-brand-600">03</span><h3 class="mt-3 text-lg font-bold text-ink">Review the installation</h3><p class="mt-3 text-sm leading-7 text-copy">Consider camera positions, cable routing, available dashboard space and connectivity requirements.</p></li>
      </ol>
      <a href="/solutions" class="mt-8 inline-flex min-h-12 items-center gap-3 rounded-pill bg-brand-500 px-6 py-3 text-sm font-bold text-white hover:bg-brand-600">Explore system specifications <span aria-hidden="true">→</span></a>
    </div>
  </section>
</BaseLayout>
