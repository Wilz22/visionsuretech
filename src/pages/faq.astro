---
import BaseLayout from '../layouts/BaseLayout.astro';
import FaqAccordion from '../components/faq/FaqAccordion.astro';
import { getFaqGroups } from '../lib/faq';
const groups = await getFaqGroups();
const schema = {
  '@context': 'https://schema.org', '@type': 'FAQPage',
  mainEntity: groups.flatMap((group) => group.items).map((item) => ({
    '@type': 'Question', name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answer },
  })),
};
---

<BaseLayout title="Frequently Asked Questions" description="Answers about VisionSure camera systems, recording, radar, remote fleet access, installation requirements and planning your quote." image="/images/solutions/vst-s6301.jpg">
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, '\\u003c')} />
  <section class="border-b border-line-light bg-page pt-10 pb-14 sm:pb-16">
    <div class="container">
      <nav aria-label="Breadcrumb" class="text-sm text-copy"><ol class="flex gap-3"><li><a href="/" class="hover:text-brand-600">Home</a></li><li aria-hidden="true">/</li><li aria-current="page">FAQ</li></ol></nav>
      <p class="mt-12 text-xs font-extrabold tracking-widest text-brand-600 uppercase">Frequently asked questions</p>
      <h1 class="mt-5 max-w-3xl text-4xl leading-[1.05] font-bold tracking-[-0.045em] text-ink sm:text-6xl">Clear answers.<br />Informed choices.</h1>
      <p class="mt-6 max-w-2xl text-lg leading-8 text-copy">Explore the differences between systems, understand their capabilities and prepare the details for your equipment.</p>
      <nav aria-label="FAQ topics" class="mt-9"><ul class="flex flex-wrap gap-3">{groups.map((group) => <li><a href={`#${group.id}`} class="inline-flex min-h-12 items-center rounded-pill border border-line-medium bg-white px-5 py-3 text-sm font-bold text-brand-600 hover:border-brand-500">{group.title}</a></li>)}</ul></nav>
    </div>
  </section>
  <div class="container divide-y divide-line-light">
    {groups.map((group, index) => <section id={group.id} aria-labelledby={`${group.id}-heading`} class="grid scroll-mt-28 items-start gap-8 py-14 lg:grid-cols-[0.65fr_1.35fr] lg:gap-16 sm:py-16">
      <div><p class="text-xs font-bold tracking-widest text-brand-600">0{index + 1}</p><h2 id={`${group.id}-heading`} class="mt-3 text-3xl leading-tight font-bold tracking-tight text-ink">{group.title}</h2><p class="mt-4 leading-7 text-copy">{group.description}</p></div>
      <FaqAccordion items={group.items} prefix="faq" />
    </section>)}
  </div>
  <section class="bg-surface-brand py-14 sm:py-16"><div class="container flex flex-wrap items-center justify-between gap-7"><div class="max-w-xl"><h2 class="text-3xl font-bold tracking-tight text-ink">Take a closer look at the systems.</h2><p class="mt-4 leading-7 text-copy">Compare specifications, components and options in the complete catalog.</p></div><a href="/solutions" class="inline-flex min-h-12 items-center gap-3 rounded-pill bg-brand-500 px-6 py-3 text-sm font-bold text-white hover:bg-brand-600">Explore solutions <span aria-hidden="true">→</span></a></div></section>
</BaseLayout>
