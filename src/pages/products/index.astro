---
import ListingLayout from '../../components/templates/ListingLayout.astro';
import ProductOverview from '../../components/products/ProductOverview.astro';
import {getPublishedProducts} from '../../lib/products';
import {buildCategoryLinks} from '../../lib/listing-models';
import {productUrl} from '../../lib/routes';
import {routes} from '../../data/company';
import {getMessages} from '../../i18n';
import {defaultLocale} from '../../i18n/config';
const messages=getMessages();
const copy=messages.productOverview;
const products=await getPublishedProducts();
---
<ListingLayout title={copy.title} description={copy.description} breadcrumbLabel={messages.common.breadcrumb} crumbs={[{label:messages.navigation.labels.home,href:routes.home},{label:copy.title}]}><ProductOverview products={products} categories={buildCategoryLinks(messages)} messages={messages} quoteHref={routes.quote} productHref={product=>productUrl(product.data)} locale={defaultLocale}/></ListingLayout>
