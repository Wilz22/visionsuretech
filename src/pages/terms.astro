---
import LegalDocument from '../components/legal/LegalDocument.astro';
import { buildLegalDocument } from '../lib/legal-content';
import { getMessages } from '../i18n';
import { routes } from '../data/company';
const messages = getMessages();
const document = buildLegalDocument('terms', messages.legalEditorial);
---

<LegalDocument
  document={document}
  messages={messages}
  homeHref={routes.home}
  contactHref={routes.contact}
/>
