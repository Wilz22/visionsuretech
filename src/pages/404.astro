---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Page not found" description="This page could not be found. Explore VisionSure solutions or return to the home page." noindex image="/images/solutions/vst-s6301.jpg">
  <section class="container py-20 sm:py-28">
    <div class="mx-auto max-w-3xl text-center">
      <p class="text-sm font-extrabold tracking-[0.2em] text-brand-600">404 / PAGE NOT FOUND</p>
      <h1 class="mt-6 text-4xl font-bold leading-[1.08] tracking-[-0.045em] text-ink sm:text-6xl">Let’s get you<br />back in view.</h1>
      <p class="mx-auto mt-6 max-w-xl text-lg leading-8 text-copy">The page may have moved, or the address may be incorrect. Use one of the links below to continue.</p>
      <div class="mt-9 flex flex-wrap justify-center gap-3"><a href="/" class="inline-flex min-h-12 items-center rounded-pill bg-brand-500 px-6 py-3 text-sm font-bold text-white hover:bg-brand-600">Back to Home</a><a href="/solutions" class="inline-flex min-h-12 items-center rounded-pill border border-line-medium bg-white px-6 py-3 text-sm font-bold text-brand-600 hover:border-brand-500">Explore solutions</a></div>
    </div>
    <nav aria-label="More ways to continue" class="mx-auto mt-14 grid max-w-4xl gap-4 sm:grid-cols-3">{[{ href: '/industries', title: 'Find your industry', text: 'Explore applications for your operation.' }, { href: '/faq', title: 'Find an answer', text: 'Compare functions and plan your configuration.' }, { href: '/contact', title: 'Plan a request', text: 'Start with your equipment requirements.' }].map((item) => <a href={item.href} class="rounded-panel border border-line-light bg-white p-7 hover:border-brand-400"><h2 class="text-lg font-bold text-ink">{item.title} <span class="text-brand-600" aria-hidden="true">→</span></h2><p class="mt-3 text-sm leading-7 text-copy">{item.text}</p></a>)}</nav>
  </section>
</BaseLayout>
