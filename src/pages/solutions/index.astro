---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SystemCard from '../../components/solutions/SystemCard.astro';
import { getPublishedSolutions } from '../../lib/solutions';
import { solutionCategories } from '../../data/solutionCategories';

const solutions = await getPublishedSolutions();
const categories = solutionCategories.filter((category) => solutions.some(({ data }) => data.category === category.id));
---

<BaseLayout title="Camera, Recording & Detection Systems" description="Explore VisionSure camera systems, DVR recording, 360° visibility, radar detection, remote fleet monitoring and boom-tip zoom systems." image="/images/solutions/vst-s6301.jpg">
  <section class="border-b border-line-light bg-page pt-10 pb-16 sm:pb-20">
    <div class="container">
      <nav aria-label="Breadcrumb" class="mb-12 text-sm text-copy"><ol class="flex flex-wrap gap-3"><li><a href="/" class="hover:text-brand-600">Home</a></li><li aria-hidden="true">/</li><li aria-current="page">Solutions</li></ol></nav>
      <div class="grid gap-8 lg:grid-cols-[1.2fr_0.8fr] lg:items-end">
        <div>
          <p class="text-xs font-extrabold tracking-[0.14em] text-brand-600 uppercase">VisionSure systems</p>
          <h1 class="mt-5 max-w-3xl text-4xl leading-[1.05] font-bold tracking-[-0.045em] text-ink sm:text-6xl">The right view.<br />For the job ahead.</h1>
        </div>
        <div>
          <p class="max-w-xl text-lg leading-8 text-copy">From live visibility to connected fleet monitoring, find a system built around what your operation needs to see, record or detect.</p>
          <p class="mt-6 text-sm font-bold text-brand-600">{solutions.length} systems <span class="px-3" aria-hidden="true">/</span> {categories.length} ways to improve awareness</p>
        </div>
      </div>
      <nav aria-label="Solution categories" class="mt-12">
        <ul class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
          {categories.map((category) => (
            <li><a href={`#${category.id}`} class="flex h-full items-center justify-between gap-4 rounded-control border border-line-light bg-white px-5 py-4 transition-colors hover:border-brand-400">
              <span><span class="block text-xs font-extrabold tracking-widest" style={{ color: category.color }}>{category.name}</span><span class="mt-1 block text-sm font-semibold text-ink">{category.title}</span></span>
              <span aria-hidden="true" class="text-brand-600">↓</span>
            </a></li>
          ))}
        </ul>
      </nav>
    </div>
  </section>

  <div class="container divide-y divide-line-light">
    {categories.map((category) => {
      const systems = solutions.filter(({ data }) => data.category === category.id);
      return (
        <section id={category.id} aria-labelledby={`${category.id}-heading`} class="scroll-mt-28 py-16 sm:py-20">
          <div class="grid gap-8 lg:grid-cols-[0.7fr_1.7fr] lg:gap-14">
            <div>
              <p class="inline-flex rounded-pill px-4 py-1.5 text-xs font-extrabold tracking-widest text-white" style={{ backgroundColor: category.color }}>{category.name}</p>
              <h2 id={`${category.id}-heading`} class="mt-5 text-3xl leading-tight font-bold tracking-tight text-ink sm:text-4xl">{category.title}</h2>
              <p class="mt-5 max-w-lg leading-7 text-copy">{category.description}</p>
              <p class="mt-5 text-xs font-bold tracking-widest text-muted uppercase">{systems.length} {systems.length === 1 ? 'system' : 'systems'}</p>
            </div>
            <div class:list={['grid gap-6', systems.length > 1 ? 'md:grid-cols-2' : 'max-w-xl w-full']}>
              {systems.map((solution) => <SystemCard solution={solution} />)}
            </div>
          </div>
        </section>
      );
    })}
  </div>
</BaseLayout>
