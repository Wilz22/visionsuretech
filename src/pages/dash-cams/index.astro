---
import DashCamOverview from '../../components/dash-cams/DashCamOverview.astro';
import { resolveDashCams } from '../../lib/dash-cam-content';
import { getMessages } from '../../i18n';
import { defaultLocale } from '../../i18n/config';
import { resolveVantrueDashCams } from '../../lib/vantrue-dash-cams';
const messages = getMessages();
const actualModels = resolveVantrueDashCams(messages.vantrue);
const restocking = resolveDashCams(messages.dashCamEditorial)
  .filter((model) => model.slug === 'front-4k')
  .map((model) => ({
    ...model,
    availabilityLabel: messages.vantrue.restocking,
  }));
const dashCams = [...actualModels, ...restocking];
const copy = {
  ...messages.dashCamOverview,
  title: messages.vantrue.title,
  description: messages.vantrue.description,
  notice: messages.vantrue.notice,
};
---

<DashCamOverview
  models={dashCams}
  copy={copy}
  cardCopy={messages.dashCamCard}
  locale={defaultLocale}
  assessmentHref="/dash-cams/book-assessment/"
  modelHref={(model) =>
    actualModels.find((item) => item.slug === model.slug)?.href ??
    `/dash-cams/${model.slug}/`
  }
/>
