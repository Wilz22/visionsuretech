---
import DashCamOverview from '../../components/dash-cams/DashCamOverview.astro';
import { resolveDashCams } from '../../lib/dash-cam-content';
import { getMessages } from '../../i18n';
import { defaultLocale } from '../../i18n/config';
const messages = getMessages();
const dashCams = resolveDashCams(messages.dashCamEditorial);
---

<DashCamOverview
  models={dashCams}
  copy={messages.dashCamOverview}
  cardCopy={messages.dashCamCard}
  locale={defaultLocale}
  assessmentHref="/dash-cams/book-assessment/"
  modelHref={(model) => `/dash-cams/${model.slug}/`}
/>
