---
import ContentLayout from '../../components/templates/ContentLayout.astro';
import ReferenceContent from '../../components/pages/ReferenceContent.astro';
import { getMessages } from '../../i18n';
import { routes } from '../../data/company';
const messages = getMessages();
const copy = messages.whyBuyLocal;
---

<ContentLayout
  title={copy.title}
  description={copy.description}
  reference
  copy={messages.contentLayout}
  breadcrumbLabel={messages.common.breadcrumb}
  crumbs={[
    { label: messages.navigation.labels.home, href: routes.home },
    { label: copy.title },
  ]}
>
  <ReferenceContent
    sections={copy.sections}
    actionLabel={copy.action}
    actionHref={'/dash-cams/book-assessment/'}
    variant="primary"
  />
</ContentLayout>
