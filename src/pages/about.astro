---
import BaseLayout from '../layouts/BaseLayout.astro';
import View from '../components/pages/AboutContent.astro';
import team from '../assets/team/visionsure-founders.jpg';
import { getImage } from 'astro:assets';
import { getMessages } from '../i18n';
import { company, routes } from '../data/company';
const messages = getMessages(),
  copy = messages.about;
const social = await getImage({ src: team, width: 800, format: 'webp' });
const schema = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  '@id': company.canonicalUrl + '/about/#webpage',
  url: company.canonicalUrl + '/about/',
  name: copy.title,
  description: copy.description,
  mainEntity: { '@id': company.canonicalUrl + '/#organization' },
  about: [
    { '@id': company.canonicalUrl + '/about/#jacob' },
    { '@id': company.canonicalUrl + '/about/#maria' },
  ],
};
---

<BaseLayout
  title={copy.seoTitle}
  description={copy.description}
  image={social.src}
>
  <script
    slot="head"
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(schema).replace(/</g, '\\u003c')}
  />
  <View
    copy={copy}
    email={company.contact.email}
    quoteHref={routes.quote}
    quoteLabel={messages.common.quote}
  />
</BaseLayout>
