# Optional assessment calendar URL. Keep empty until the client selects a booking flow.
PUBLIC_ASSESSMENT_BOOKING_URL=

# Keep local preparation mode until a real Formspree form and recipient exist.
PUBLIC_QUOTE_SEND_ENABLED=false
PUBLIC_FORMSPREE_FORM_ID=
# Example format: the ID shown after https://formspree.io/f/ in your dashboard.
# This public identifier is not an API key. Never add SMTP/API secrets here.
